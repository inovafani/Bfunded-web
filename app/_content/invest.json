"<style>\n      *,\n      *::before,\n      *::after {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      :root {\n        --ivory: #f7fbf8;\n        --ivory2: #e9f4ee;\n        --cardiv: #ffffff;\n        --dark: #e9f4ee;\n        --panel: #2b2b2b;\n        --panel2: #363636;\n        --ink: #16302b;\n        --dim: #6b7a74;\n        --white: #fff;\n        --gold: #279b72;\n        --gold2: #8be3bb;\n        --green: #2e9e77;\n        --mint: #8be3bb;\n        --goldfill: linear-gradient(135deg, #1f8f66, #2fb583);\n        --pop: \"Poppins\", sans-serif;\n        --sans: \"Hanken Grotesk\", sans-serif;\n        --serif: \"Fraunces\", Georgia, serif;\n      }\n      html {\n        scroll-behavior: smooth;\n        scroll-padding-top: 108px;\n      }\n      body {\n        background: var(--ivory);\n        color: var(--ink);\n        font-family: var(--sans);\n        font-size: 17px;\n        line-height: 1.5;\n        -webkit-font-smoothing: antialiased;\n        overflow-x: hidden;\n      }\n      a {\n        color: inherit;\n        text-decoration: none;\n      }\n      img {\n        max-width: 100%;\n        display: block;\n      }\n      .wrap {\n        max-width: 1060px;\n        margin: 0 auto;\n        padding: 0 28px;\n      }\n      .sec {\n        padding: 104px 0;\n      }\n      .dk {\n        background: var(--dark);\n        color: #5c6b66;\n      }\n      .dk .sub {\n        color: var(--dim);\n      }\n\n      /* headline grammar: bold Poppins, one gold phrase */\n      .h {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(30px, 3.8vw, 52px);\n        line-height: 1.2;\n        text-align: center;\n        letter-spacing: -0.015em;\n        max-width: 900px;\n        margin: 0 auto;\n      }\n      .h em {\n        font-style: normal;\n        color: var(--gold);\n      }\n      .dk .h {\n        color: var(--ink);\n      }\n      .dk .h em {\n        color: var(--gold);\n      }\n      .sub {\n        text-align: center;\n        font-size: 17px;\n        color: var(--dim);\n        margin: 10px auto 0;\n        max-width: 56ch;\n      }\n\n      /* visual cards */\n      .vc {\n        border-radius: 20px;\n        overflow: hidden;\n        max-width: 960px;\n        margin-left: auto;\n        margin-right: auto;\n        box-shadow: 0 18px 44px -26px rgba(30, 30, 20, 0.45);\n        margin: 26px auto 0;\n      }\n      .bk {\n        position: relative;\n        min-height: 400px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      .bk > img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n      }\n      .bk .scrim {\n        position: absolute;\n        inset: 0;\n        background: rgba(20, 26, 18, 0.62);\n      }\n      .bko {\n        position: relative;\n        padding: 40px 34px;\n        text-align: center;\n        color: #fff;\n        font-family: var(--pop);\n      }\n      .bko .big {\n        font-weight: 700;\n        font-size: clamp(30px, 4.6vw, 44px);\n        line-height: 1.4;\n        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45);\n      }\n      .bko .big b {\n        color: var(--gold2);\n      }\n      .bko .rows {\n        margin: 18px auto 0;\n        display: flex;\n        flex-direction: column;\n        gap: 8px;\n        font-weight: 600;\n        font-size: 17px;\n      }\n      .bko .rows span b {\n        color: var(--gold2);\n      }\n      .bko .mid {\n        margin-top: 18px;\n        font-weight: 600;\n        font-size: clamp(15px, 2vw, 18px);\n        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);\n      }\n\n      /* dark breakdown table card */\n      .brk {\n        background: var(--panel);\n        position: relative;\n        padding: 34px 30px;\n      }\n      .brk > * {\n        position: relative;\n      }\n      .brk h3 {\n        font-family: var(--pop);\n        font-weight: 700;\n        color: #fff;\n        font-size: clamp(26px, 3.8vw, 36px);\n        text-align: center;\n        margin-bottom: 20px;\n      }\n      .brow {\n        display: flex;\n        justify-content: space-between;\n        align-items: baseline;\n        padding: 15px 2px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n        color: #e8ecea;\n        font-size: clamp(26px, 3.6vw, 33px);\n        font-weight: 500;\n      }\n      .brow b {\n        font-family: var(--pop);\n        color: var(--gold2);\n        font-weight: 700;\n        font-size: clamp(22px, 3vw, 28px);\n        white-space: nowrap;\n      }\n      .brow.tot {\n        border-bottom: none;\n        border-top: 2px solid rgba(255, 255, 255, 0.25);\n        margin-top: 8px;\n        padding-top: 14px;\n        color: #fff;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n      }\n      .brow.tot b {\n        font-size: clamp(28px, 4vw, 38px);\n      }\n      .brk .note {\n        text-align: center;\n        color: #b9c2bd;\n        font-size: 17px;\n        margin-top: 14px;\n      }\n\n      /* 2-col dark comparison table */\n      .cmp2 {\n        background: var(--panel);\n        position: relative;\n        padding: 34px 26px;\n      }\n      .cmp2 > * {\n        position: relative;\n      }\n      .cmp2 h3 {\n        font-family: var(--pop);\n        font-weight: 700;\n        color: #fff;\n        font-size: clamp(26px, 3.8vw, 36px);\n        text-align: center;\n        margin-bottom: 22px;\n      }\n      .c2row {\n        display: grid;\n        grid-template-columns: 1fr 1.1fr 1fr;\n        align-items: center;\n        text-align: center;\n        padding: 10px 0;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n      }\n      .c2row:last-of-type {\n        border-bottom: none;\n      }\n      .c2row .l {\n        font-family: var(--pop);\n        font-weight: 600;\n        color: #b9c2ae;\n        font-size: clamp(20px, 2.8vw, 27px);\n      }\n      .c2row .m {\n        font-size: 17px;\n        color: #9aa39e;\n        font-weight: 600;\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n      }\n      .c2row .r {\n        font-family: var(--pop);\n        font-weight: 700;\n        color: var(--gold2);\n        font-size: clamp(22px, 3.2vw, 30px);\n      }\n      .c2hd .l,\n      .c2hd .r {\n        font-size: 17px !important;\n        text-transform: uppercase;\n        letter-spacing: 0.08em;\n        color: #9aa39e !important;\n      }\n\n      /* founders */\n      .fdr {\n        display: grid;\n        grid-template-columns: 400px 1fr;\n        gap: 56px;\n        align-items: center;\n        margin: 56px auto 0;\n        max-width: 920px;\n      }\n      .fdr.rev {\n        grid-template-columns: 1fr 400px;\n      }\n      .fdr.rev .txt {\n        text-align: right;\n      }\n      .fdr.rev li {\n        padding-left: 0;\n        padding-right: 18px;\n      }\n      .fdr.rev li::before {\n        left: auto;\n        right: 2px;\n      }\n      .fdr .ph {\n        border-radius: 24px;\n        overflow: hidden;\n        box-shadow: 0 16px 36px -22px rgba(30, 30, 20, 0.5);\n      }\n      .fdr .ph img {\n        aspect-ratio: 0.84;\n        object-fit: cover;\n        width: 100%;\n      }\n      .fdr h4 {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 38px;\n        letter-spacing: -0.015em;\n      }\n      .fdr .badge {\n        display: inline-block;\n        background: var(--ink);\n        color: #fff;\n        font-size: 17px;\n        font-weight: 600;\n        font-family: var(--pop);\n        padding: 7px 17px;\n        border-radius: 100px;\n        margin: 10px 0 16px;\n      }\n      .fdr ul {\n        list-style: none;\n        display: flex;\n        flex-direction: column;\n        gap: 9px;\n      }\n      .fdr li {\n        font-size: 19px;\n        color: #57544a;\n        font-weight: 500;\n        padding-left: 18px;\n        position: relative;\n        line-height: 1.55;\n      }\n      .fdr li::before {\n        content: \"\u00b7\";\n        position: absolute;\n        left: 2px;\n        color: var(--gold);\n      }\n      .fdr li b {\n        color: var(--ink);\n      }\n      @media (max-width: 820px) {\n        .fdr,\n        .fdr.rev {\n          grid-template-columns: 1fr;\n        }\n        .fdr.rev .txt {\n          text-align: left;\n        }\n        .fdr.rev li {\n          padding: 0 0 0 18px;\n        }\n        .fdr.rev li::before {\n          left: 2px;\n          right: auto;\n        }\n        .fdr .ph {\n          max-width: 320px;\n        }\n      }\n\n      /* stat rows */\n      .nums {\n        display: flex;\n        justify-content: center;\n        gap: clamp(22px, 6vw, 64px);\n        flex-wrap: wrap;\n        margin: 28px auto 0;\n        text-align: center;\n      }\n      .nums .n b {\n        display: block;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(34px, 5vw, 48px);\n        letter-spacing: -0.01em;\n      }\n      .nums .n span {\n        font-size: 17px;\n        color: var(--dim);\n        font-weight: 600;\n      }\n      .dk .nums .n b {\n        color: var(--ink);\n      }\n      .dk .nums .n span {\n        color: var(--dim);\n      }\n\n      /* ladder / funnel card */\n      .lad {\n        background: var(--panel);\n        padding: 30px 26px;\n      }\n      .lrow2 {\n        display: grid;\n        grid-template-columns: auto 1fr auto;\n        gap: 14px;\n        align-items: center;\n        padding: 12px 4px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n      }\n      .lrow2:last-child {\n        border-bottom: none;\n      }\n      .lrow2 .tag {\n        font-family: var(--pop);\n        font-size: 17px;\n        font-weight: 700;\n        letter-spacing: 0.08em;\n        text-transform: uppercase;\n        color: #9aa39e;\n        width: 52px;\n      }\n      .lrow2 .lt {\n        color: #e8ecea;\n        font-size: clamp(26px, 3.6vw, 34px);\n        font-weight: 500;\n      }\n      .lrow2 .lv {\n        font-family: var(--pop);\n        font-weight: 700;\n        color: var(--gold2);\n        font-size: clamp(22px, 3vw, 28px);\n        white-space: nowrap;\n      }\n      .lrow2.hot .lt,\n      .lrow2.hot .tag {\n        color: #fff;\n      }\n      .lrow2.hot .lv {\n        color: var(--mint);\n      }\n\n      /* 5yr return card */\n      .ret {\n        background: var(--panel);\n        position: relative;\n        padding: 32px 26px 26px;\n      }\n      .ret > * {\n        position: relative;\n      }\n      .ret .bands {\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n        align-items: flex-start;\n        margin-bottom: 16px;\n      }\n      .ret .band {\n        background: rgba(200, 210, 180, 0.85);\n        color: #2a3226;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: 17px;\n        border-radius: 100px;\n        padding: 5px 16px;\n        text-align: center;\n      }\n      .ret .bars {\n        display: flex;\n        align-items: flex-end;\n        gap: 8px;\n        height: 230px;\n      }\n      .ret .bar {\n        flex: 1;\n        background: #f7f4ea;\n        border-radius: 8px 8px 4px 4px;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: flex-start;\n        padding-top: 8px;\n        position: relative;\n      }\n      .ret .bar .v {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(14px, 2vw, 19px);\n        color: #26261f;\n      }\n      .ret .bar .x {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(13px, 1.8vw, 16px);\n        color: var(--gold);\n      }\n      .ret .bar .yr {\n        position: absolute;\n        bottom: 8px;\n        font-size: 17px;\n        color: #7b7668;\n        font-weight: 600;\n        text-align: center;\n        width: 100%;\n      }\n      .ret .note {\n        text-align: center;\n        color: #b9c2bd;\n        font-size: 17px;\n        margin-top: 12px;\n        font-style: italic;\n      }\n\n      /* comparables duo */\n      .cduo {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 16px;\n        margin: 26px auto 0;\n      }\n      .cx {\n        border-radius: 14px;\n        overflow: hidden;\n        box-shadow: 0 16px 40px -26px rgba(30, 30, 20, 0.5);\n      }\n      .cx .cim {\n        position: relative;\n        min-height: 150px;\n        background: var(--panel2);\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      .cx .cim img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.35;\n      }\n      .cx .cim .wm {\n        position: relative;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 26px;\n        color: #fff;\n        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);\n      }\n      .cx .cim .chip {\n        position: absolute;\n        bottom: 10px;\n        left: 50%;\n        transform: translateX(-50%);\n        background: rgba(20, 26, 18, 0.85);\n        color: #fff;\n        font-family: var(--pop);\n        font-size: 17px;\n        font-weight: 600;\n        padding: 4px 12px;\n        border-radius: 100px;\n        white-space: nowrap;\n      }\n      .cx .cst {\n        background: var(--white);\n        display: flex;\n        justify-content: center;\n        gap: 26px;\n        padding: 14px 10px;\n        text-align: center;\n      }\n      .cx .cst .n b {\n        display: block;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 30px;\n      }\n      .cx .cst .n span {\n        font-size: 17px;\n        color: var(--dim);\n        font-weight: 600;\n      }\n      @media (max-width: 560px) {\n        .cduo {\n          grid-template-columns: 1fr;\n        }\n      }\n\n      /* position flow card */\n      .posc {\n        background: var(--panel);\n        padding: 34px 26px;\n        text-align: center;\n      }\n      .posc .fl {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 8px;\n        flex-wrap: wrap;\n      }\n      .posc .pn {\n        background: rgba(255, 255, 255, 0.08);\n        border: 1px solid rgba(255, 255, 255, 0.15);\n        border-radius: 12px;\n        padding: 12px 14px;\n        color: #e8ecea;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: 17px;\n        white-space: nowrap;\n      }\n      .posc .pn b {\n        display: block;\n        font-size: 20px;\n        color: #fff;\n      }\n      .posc .pn.hot {\n        background: var(--gold);\n        border-color: transparent;\n        color: #fff;\n      }\n      .posc .pn.hot b {\n        color: #fff;\n      }\n      .posc .ar {\n        color: var(--gold2);\n        font-weight: 700;\n        font-size: 20px;\n      }\n      .posc .fico {\n        margin-top: 26px;\n        color: #eef1ef;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(17px, 2.4vw, 21px);\n      }\n      .posc .fico b {\n        color: var(--gold2);\n      }\n      @media (max-width: 640px) {\n        .posc .fl {\n          flex-direction: column;\n        }\n        .posc .ar {\n          transform: rotate(90deg);\n        }\n      }\n\n      /* raises chart card */\n      .grz {\n        background: var(--panel);\n        position: relative;\n      }\n      .grz > * {\n        position: relative;\n      }\n      .grz .ct2 {\n        font-family: var(--pop);\n        color: #fff;\n        font-weight: 700;\n        font-size: clamp(24px, 3.4vw, 32px);\n        text-align: center;\n        padding: 26px 14px 4px;\n      }\n\n      /* hard rows + hires */\n      .hrow {\n        display: grid;\n        grid-template-columns: 1.15fr 0.85fr;\n        gap: 16px;\n        padding: 13px 2px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        align-items: center;\n      }\n      .hrow .hx b {\n        display: block;\n        font-family: var(--pop);\n        font-weight: 700;\n        color: #fff;\n        font-size: clamp(18px, 2.6vw, 23px);\n      }\n      .hrow .hx span {\n        font-size: clamp(14px, 2vw, 17px);\n        color: #b9c2bd;\n        font-weight: 500;\n      }\n      .hrow .hok {\n        font-size: clamp(22px, 3.3vw, 28px);\n        color: var(--mint);\n        font-weight: 600;\n      }\n      .hrow .hok:empty {\n        display: none;\n      }\n      .hrow:has(.hok:empty) {\n        grid-template-columns: 1fr;\n      }\n      .hirer {\n        display: flex;\n        justify-content: space-between;\n        gap: 14px;\n        align-items: baseline;\n        padding: 12px 0;\n        border-bottom: 1px solid #d9ebe1;\n        flex-wrap: wrap;\n      }\n      .hirer:last-of-type {\n        border-bottom: none;\n      }\n      .hirer .hn {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(17px, 2.4vw, 21px);\n        color: var(--gold);\n      }\n      .hirer .hd {\n        font-size: 17px;\n        color: #57544a;\n        font-weight: 500;\n      }\n      @media (max-width: 560px) {\n        .hrow {\n          grid-template-columns: 1fr;\n          gap: 6px;\n        }\n      }\n\n      /* problem 2-col grid */\n      .prows {\n        margin: 32px auto 0;\n        max-width: 560px;\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n      }\n      .prow {\n        display: flex;\n        justify-content: space-between;\n        align-items: baseline;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.28);\n        padding: 14px 4px;\n      }\n      .prow:last-child {\n        border-bottom: none;\n      }\n      .prow span {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(28px, 3.8vw, 42px);\n        color: #fff;\n      }\n      .prow b {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(38px, 5vw, 62px);\n        color: var(--gold2);\n      }\n\n      /* deck wall - pair-3 problem graphic */\n      .dwall {\n        display: grid;\n        grid-template-columns: repeat(6, 1fr);\n        gap: 10px;\n        max-width: 600px;\n        margin: 0 auto;\n      }\n      .dmini {\n        background: rgba(255, 255, 255, 0.1);\n        border: 1px solid rgba(255, 255, 255, 0.13);\n        border-radius: 6px;\n        aspect-ratio: 3/4;\n        padding: 9px 8px;\n        display: flex;\n        flex-direction: column;\n        gap: 5px;\n      }\n      .dmini i {\n        display: block;\n        height: 5px;\n        border-radius: 3px;\n        background: rgba(255, 255, 255, 0.22);\n      }\n      .dmini i:nth-child(2) {\n        width: 70%;\n      }\n      .dmini i:nth-child(4) {\n        width: 55%;\n      }\n      .dwq {\n        margin-top: 32px;\n        text-align: center;\n        font-family: var(--pop);\n        font-weight: 700;\n        color: #fff;\n        font-size: clamp(22px, 3.2vw, 30px);\n      }\n      .dwq b {\n        color: var(--gold2);\n      }\n      @media (max-width: 560px) {\n        .dwall {\n          grid-template-columns: repeat(4, 1fr);\n        }\n        .dwall .dmini:nth-child(n + 13) {\n          display: none;\n        }\n      }\n\n      /* \u2550\u2550\u2550 10X pass: depth, light, gold foil \u2550\u2550\u2550 */\n\n      /* premium dark-card edge: gold hairline + top edge-light + deeper shadow */\n      .pnl,\n      .brk,\n      .cmp2,\n      .grz,\n      .ret,\n      .vc.lad,\n      .vc.posc {\n        border: 1px solid rgba(255, 255, 255, 0.06);\n        box-shadow:\n          0 30px 70px -30px rgba(8, 12, 7, 0.8),\n          inset 0 1px 0 rgba(255, 255, 255, 0.09);\n      }\n\n      /* gold-foil gradient numerals */\n      .vc h3 span,\n      .vc h3 b {\n        background: linear-gradient(135deg, #1f8f66, #2fb583);\n        -webkit-background-clip: text;\n        background-clip: text;\n        color: transparent !important;\n      }\n      .pnl h3 span,\n      .pnl h3 b,\n      .obody b {\n        background: linear-gradient(135deg, #8be3bb, #a9ecda);\n        -webkit-background-clip: text;\n        background-clip: text;\n        color: transparent !important;\n      }\n      .bko .big b {\n        text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);\n      }\n\n      /* cinematic scrim for photo cards */\n      .bk .scrim {\n        background: linear-gradient(\n          180deg,\n          rgba(20, 26, 18, 0.74),\n          rgba(20, 26, 18, 0.42) 42%,\n          rgba(12, 17, 11, 0.8)\n        );\n      }\n\n      /* day-one timeline - pair-1 solution */\n      .tl3 {\n        position: relative;\n        padding: 72px 6px 80px;\n        max-width: 640px;\n        margin: 0 auto;\n      }\n      .tl3 .line {\n        position: absolute;\n        left: 2%;\n        right: 2%;\n        top: 50%;\n        height: 3px;\n        background: rgba(255, 255, 255, 0.14);\n        border-radius: 2px;\n      }\n      .tl3 .seg {\n        position: absolute;\n        left: 2%;\n        top: 50%;\n        height: 3px;\n        width: 9%;\n        background: linear-gradient(90deg, #a9ecda, var(--gold2));\n        border-radius: 2px;\n      }\n      .tl3 .nd {\n        position: absolute;\n        top: 50%;\n        transform: translate(-50%, -50%);\n        width: 15px;\n        height: 15px;\n        border-radius: 50%;\n        background: #4a4a4a;\n      }\n      .tl3 .nd.g {\n        width: 28px;\n        height: 28px;\n        background: radial-gradient(circle at 35% 35%, #a9ecda, #8be3bb);\n        box-shadow:\n          0 0 0 6px rgba(201, 164, 94, 0.16),\n          0 4px 12px rgba(0, 0, 0, 0.4);\n      }\n      .tl3 .lbl {\n        position: absolute;\n        transform: translateX(-50%);\n        text-align: center;\n        font-family: var(--pop);\n        width: 150px;\n      }\n      .tl3 .lbl b {\n        display: block;\n        font-weight: 700;\n        font-size: clamp(22px, 3.2vw, 28px);\n        color: #e8ecea;\n        line-height: 1.25;\n      }\n      .tl3 .lbl span {\n        font-size: clamp(11px, 1.6vw, 13px);\n        font-weight: 700;\n        color: #9aa39e;\n        text-transform: uppercase;\n        letter-spacing: 0.07em;\n      }\n      .tl3 .lbl.up {\n        bottom: calc(50% + 26px);\n      }\n      .tl3 .lbl.dn {\n        top: calc(50% + 26px);\n      }\n      .tl3 .lbl.g b {\n        color: var(--gold2);\n        font-size: clamp(17px, 2.4vw, 22px);\n      }\n      .tl3 .lbl.g span {\n        color: #8be3bb;\n      }\n      @media (max-width: 560px) {\n        .tl3 .lbl {\n          width: 100px;\n        }\n        .tl3 {\n          padding: 66px 2px 72px;\n        }\n      }\n\n      /* deck wall - giant ghost question mark */\n      .dwall {\n        position: relative;\n      }\n      .dwall::after {\n        content: \"?\";\n        position: absolute;\n        inset: 0;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: min(46vw, 330px);\n        line-height: 1;\n        color: rgba(201, 164, 94, 0.12);\n        text-shadow: 0 0 90px rgba(201, 164, 94, 0.3);\n        pointer-events: none;\n      }\n      .dmini {\n        box-shadow: 0 8px 20px -10px rgba(0, 0, 0, 0.45);\n      }\n\n      /* time bars - thicker, glossy, glowing gold cap */\n      .tb .ttr {\n        height: 32px;\n        border-radius: 11px;\n      }\n      .tb .ttr i {\n        position: relative;\n        border-radius: 11px;\n      }\n\n      /* 5-year return - Year 5 goes gold */\n      .ret .bar:last-child {\n        background: linear-gradient(180deg, #a9ecda, #2fb583);\n        box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.45);\n      }\n      .ret .bar:last-child .v {\n        color: #0f3527;\n      }\n      .ret .bar:last-child .x {\n        color: #155e43;\n      }\n      .ret .bar:last-child .yr {\n        color: #155e43;\n      }\n\n      /* position flow - molten gold node */\n      .posc .pn.hot {\n        background: linear-gradient(135deg, #1f8f66, #2fb583);\n        color: #fff;\n        box-shadow: 0 6px 18px -6px rgba(31, 143, 102, 0.45);\n      }\n      .posc .pn.hot b {\n        color: #fff;\n      }\n\n      /* close ring - gradient arc + glow */\n      .ring2 {\n        background: conic-gradient(\n          from -90deg,\n          #1f8f66 0,\n          #7fe0b0 44%,\n          rgba(255, 255, 255, 0.12) 44% 100%\n        );\n        box-shadow: 0 0 28px rgba(63, 194, 143, 0.25);\n      }\n\n      .cta.hero-cta {\n        font-size: clamp(16px, 2.2vw, 20px);\n        padding: 18px 34px;\n        background: var(--goldfill);\n        color: #fff;\n        box-shadow: 0 14px 34px -14px rgba(31, 143, 102, 0.5);\n      }\n      .dead {\n        display: block;\n        text-decoration: none;\n      }\n\n      .pnl .note {\n        text-align: center;\n        color: #9aa39e;\n        font-size: 17px;\n        line-height: 1.55;\n        max-width: 62ch;\n        margin-left: auto;\n        margin-right: auto;\n      }\n\n      .closepanel {\n        background: rgba(18, 23, 17, 0.9);\n        backdrop-filter: blur(3px);\n        border: 1px solid rgba(201, 164, 94, 0.22);\n        border-radius: 18px;\n        max-width: 560px;\n        margin: 30px auto 0;\n        padding: 34px 28px 30px;\n      }\n      .closecd {\n        text-align: center;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        color: #e8ecea;\n        margin-top: 18px;\n      }\n      .closecd b {\n        color: var(--gold2);\n      }\n      .closepanel .cform2 {\n        margin-top: 20px;\n      }\n\n      /* HUGE investor CTA band + sticky mobile bar */\n      .bigcta {\n        background: var(--panel);\n        position: relative;\n        overflow: hidden;\n        text-align: center;\n        padding: 72px 22px 78px;\n      }\n      .bigcta::before {\n        content: \"\";\n        position: absolute;\n        inset: 0;\n        background: radial-gradient(\n          70% 90% at 50% 0%,\n          rgba(63, 194, 143, 0.13),\n          transparent 70%\n        );\n      }\n      .bigcta > * {\n        position: relative;\n      }\n      .bigcta h2 {\n        font-family: var(--pop);\n        font-weight: 700;\n        color: #fff;\n        font-size: clamp(32px, 5.4vw, 54px);\n        line-height: 1.14;\n        letter-spacing: -0.015em;\n        max-width: 16ch;\n        margin: 0 auto;\n      }\n      .bigcta h2 em {\n        font-style: normal;\n        color: var(--gold2);\n      }\n      .bigcta .terms {\n        display: flex;\n        justify-content: center;\n        gap: 9px;\n        flex-wrap: wrap;\n        margin: 26px auto 0;\n      }\n      .bigcta .terms span {\n        background: rgba(255, 255, 255, 0.08);\n        border: 1px solid rgba(255, 255, 255, 0.15);\n        border-radius: 100px;\n        padding: 9px 17px;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: 17px;\n        color: #e8ecea;\n        white-space: nowrap;\n      }\n      .bigcta .huge {\n        display: inline-block;\n        margin-top: 32px;\n        background: var(--goldfill);\n        color: #fff;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(18px, 2.6vw, 23px);\n        padding: 22px 46px;\n        border-radius: 100px;\n        box-shadow: 0 18px 44px -18px rgba(31, 143, 102, 0.55);\n        transition: transform 0.15s;\n      }\n      .bigcta .huge:hover {\n        transform: translateY(-2px);\n      }\n      .bigcta .under {\n        margin-top: 16px;\n        font-size: 17px;\n        color: #9aa39e;\n        font-weight: 600;\n      }\n      .stickycta {\n        position: fixed;\n        left: 0;\n        right: 0;\n        bottom: 0;\n        z-index: 200;\n        background: rgba(30, 36, 29, 0.96);\n        backdrop-filter: blur(10px);\n        border-top: 1px solid rgba(63, 194, 143, 0.35);\n        padding: 11px 14px;\n        display: none;\n        align-items: center;\n        gap: 12px;\n      }\n      .stickycta .sleft {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        color: #fff;\n        line-height: 1.25;\n      }\n      .stickycta .sleft span {\n        display: block;\n        font-weight: 600;\n        font-size: 17px;\n        color: var(--gold2);\n      }\n      .stickycta a {\n        margin-left: auto;\n        background: var(--goldfill);\n        color: #fff;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        padding: 12px 22px;\n        border-radius: 100px;\n        white-space: nowrap;\n      }\n      @media (max-width: 760px) {\n        .stickycta {\n          display: flex;\n        }\n        body {\n          padding-bottom: 70px;\n        }\n      }\n\n      /* lineage table - each generation fixed the last */\n      .lin {\n        max-width: 600px;\n        margin: 0 auto;\n      }\n      .linh,\n      .linr {\n        display: grid;\n        grid-template-columns: 1.5fr 0.7fr 0.7fr 0.7fr;\n        align-items: center;\n        gap: 6px;\n      }\n      .linh {\n        padding-bottom: 12px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.16);\n      }\n      .linh .lc {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(11px, 1.7vw, 14px);\n        text-transform: uppercase;\n        letter-spacing: 0.05em;\n        color: #9aa39e;\n        text-align: center;\n      }\n      .linh .lc.g {\n        color: var(--gold2);\n      }\n      .linr {\n        padding: 13px 0;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n      }\n      .linr:last-of-type {\n        border-bottom: none;\n      }\n      .linr .ln {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(13px, 1.9vw, 17px);\n        color: #e8ecea;\n      }\n      .linr .lx,\n      .linr .lv {\n        text-align: center;\n        font-size: clamp(22px, 3.3vw, 28px);\n        font-weight: 700;\n      }\n      .linr .lx {\n        color: #5f6659;\n      }\n      .linr .lv {\n        color: #8fd0a9;\n      }\n      .linr .lv.g {\n        color: var(--gold2);\n        font-size: clamp(18px, 2.6vw, 23px);\n      }\n      .linr.new .ln {\n        color: #fff;\n      }\n      .linr.new {\n        background: rgba(201, 164, 94, 0.06);\n      }\n      @media (max-width: 560px) {\n        .linr .ln {\n          font-size: 17px;\n        }\n      }\n\n      /* flywheel */\n      .fly {\n        position: relative;\n        width: min(440px, 92%);\n        aspect-ratio: 1;\n        margin: 0 auto;\n      }\n      .fly svg {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n      }\n      .fchip {\n        position: absolute;\n        transform: translate(-50%, -50%);\n        background: rgba(255, 255, 255, 0.08);\n        border: 1px solid rgba(255, 255, 255, 0.15);\n        border-radius: 100px;\n        padding: 9px 15px;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(11px, 1.6vw, 14px);\n        color: #e8ecea;\n        white-space: nowrap;\n      }\n      .fchip.g {\n        background: linear-gradient(135deg, #b98f45, #8be3bb 45%, #a9ecda);\n        border-color: transparent;\n        color: #241c07;\n        font-weight: 700;\n      }\n      .fctr {\n        position: absolute;\n        left: 50%;\n        top: 50%;\n        transform: translate(-50%, -50%);\n        text-align: center;\n        font-family: var(--pop);\n      }\n      .fctr b {\n        display: block;\n        font-weight: 700;\n        font-size: clamp(17px, 2.4vw, 22px);\n        color: var(--gold2);\n      }\n      .fctr span {\n        font-size: 17px;\n        font-weight: 600;\n        color: #9aa39e;\n      }\n      @media (max-width: 560px) {\n        .fchip {\n          font-size: 17px;\n          padding: 6px 10px;\n        }\n      }\n\n      /* allocation bar - deal act opener */\n      .abar {\n        position: relative;\n        height: 38px;\n        background: rgba(255, 255, 255, 0.09);\n        border-radius: 12px;\n        overflow: hidden;\n        max-width: 600px;\n        margin: 0 auto;\n      }\n      .abar i {\n        display: block;\n        height: 100%;\n        width: 44%;\n        background: linear-gradient(90deg, #3ec28f, #a9ecda);\n        border-radius: 12px 0 0 12px;\n      }\n      .abar .albl {\n        position: absolute;\n        left: 14px;\n        top: 50%;\n        transform: translateY(-50%);\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        color: #0f3527;\n      }\n      .abar .arbl {\n        position: absolute;\n        right: 14px;\n        top: 50%;\n        transform: translateY(-50%);\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        color: #9aa39e;\n      }\n      .aterms {\n        display: flex;\n        justify-content: center;\n        gap: 10px;\n        flex-wrap: wrap;\n        margin-top: 22px;\n      }\n      .aterms span {\n        background: rgba(255, 255, 255, 0.08);\n        border: 1px solid rgba(255, 255, 255, 0.14);\n        border-radius: 100px;\n        padding: 8px 16px;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: 17px;\n        color: #e8ecea;\n      }\n\n      /* master value size - identical in every data card */\n      .brow:not(.tot) b,\n      .c2row .r,\n      .c2row .l,\n      .lrow2 .lv,\n      .tb b {\n        font-size: clamp(36px, 4.5vw, 45px) !important;\n      }\n\n      .gbars {\n        display: flex;\n        flex-direction: column;\n        gap: 26px;\n        max-width: 620px;\n        margin: 0 auto;\n      }\n      .gbl {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(16px, 2.2vw, 19px);\n        color: #e8ecea;\n        margin-bottom: 10px;\n      }\n      .gbrow {\n        display: grid;\n        grid-template-columns: 82px 1fr 72px;\n        gap: 12px;\n        align-items: center;\n        padding: 4px 0;\n      }\n      .gtag2 {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        letter-spacing: 0.07em;\n        text-transform: uppercase;\n        color: #9aa39e;\n      }\n      .gbrow.g .gtag2 {\n        color: var(--gold2);\n      }\n      .gtr {\n        display: block;\n        height: 22px;\n        background: rgba(255, 255, 255, 0.08);\n        border-radius: 8px;\n        overflow: hidden;\n      }\n      .gtr i {\n        display: block;\n        height: 100%;\n        border-radius: 8px;\n        background: #5a5a5a;\n        min-width: 5px;\n      }\n      .gbrow.g .gtr i {\n        background: linear-gradient(90deg, #2fb583, #a9ecda);\n      }\n      .gbrow b {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(19px, 2.6vw, 24px);\n        color: var(--gold2);\n        text-align: right;\n      }\n      .gbrow b.mut2 {\n        color: #9aa39e;\n      }\n      @media (max-width: 560px) {\n        .gbrow {\n          grid-template-columns: 58px 1fr 52px;\n        }\n        .gtag2 {\n          font-size: 17px;\n        }\n      }\n      /* two-panel market forces */\n\n      @media (max-width: 600px) {\n      }\n\n      /* unlock ladder - deck slide style */\n      .unl {\n        display: flex;\n        flex-direction: column;\n        gap: 10px;\n        max-width: 940px;\n        margin: 0 auto;\n      }\n      .ur {\n        display: grid;\n        grid-template-columns: 1fr 90px auto;\n        gap: 16px;\n        align-items: center;\n        padding: 10px 6px;\n      }\n      .ur .arw {\n        width: 90px;\n        height: 26px;\n      }\n      .ut {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(20px, 2.9vw, 24px);\n        color: #8f8f8f;\n        line-height: 1.9;\n      }\n      .ut i {\n        display: inline-block;\n        width: 15px;\n        height: 15px;\n        border-radius: 4px;\n        border: 2px solid #5d5d5d;\n        margin-right: 9px;\n        vertical-align: -2px;\n      }\n      .ur.done .ut {\n        color: #fff;\n      }\n      .ur.done .ut i {\n        background: #e8ecea;\n        border-color: #e8ecea;\n        position: relative;\n      }\n      .ur.done .ut i::after {\n        content: \"\";\n        position: absolute;\n        left: 4px;\n        top: 1px;\n        width: 3px;\n        height: 7px;\n        border-right: 2px solid #2b2b2b;\n        border-bottom: 2px solid #2b2b2b;\n        transform: rotate(45deg);\n      }\n      .ua {\n        display: flex;\n        align-items: center;\n        gap: 10px;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(22px, 3.2vw, 28px);\n        color: #fff;\n        white-space: nowrap;\n      }\n      .ua em {\n        display: block;\n        width: 7px;\n        height: 30px;\n        border-radius: 4px;\n      }\n      .ua b {\n        font-weight: 700;\n      }\n      .ur:not(.done) .ua {\n        color: #b9c2bd;\n      }\n      @media (max-width: 620px) {\n        .ur {\n          grid-template-columns: 1fr auto;\n        }\n        .ur .arw {\n          display: none;\n        }\n      }\n\n      /* odds card - white cap + charcoal pills */\n      .obody::after {\n        content: \"\";\n        position: absolute;\n        right: 16px;\n        bottom: 10px;\n        width: 70px;\n        height: 20px;\n        background: url(\"/assets/bf/logo.svg\") no-repeat center/contain;\n        opacity: 0.55;\n        filter: brightness(0) invert(1);\n      }\n      .ocap {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(16px, 2.3vw, 20px);\n        color: var(--ink);\n        text-align: center;\n        padding: 18px 16px;\n      }\n      .obody {\n        position: relative;\n        background: var(--panel);\n        border-radius: 0 0 var(--r-xl, 14px) var(--r-xl, 14px);\n        padding: 24px 22px 26px;\n      }\n      .orow {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        gap: 14px;\n        background: #3a3a3a;\n        border: 1px solid #464646;\n        border-radius: 100px;\n        padding: 12px 20px;\n        margin-bottom: 10px;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(13.5px, 1.9vw, 16px);\n        color: #e8ecea;\n      }\n      .orow b {\n        font-weight: 700;\n        color: var(--mint);\n        white-space: nowrap;\n      }\n      .orow b.mut {\n        color: #9aa39e;\n      }\n      .orow.hot {\n        border-color: rgba(63, 194, 143, 0.5);\n      }\n      .ogreen {\n        margin-top: 18px;\n        background: #2e9e77;\n        border-radius: 14px;\n        padding: 18px 24px;\n        display: flex;\n        align-items: center;\n        gap: 18px;\n        text-align: left;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(20px, 2.9vw, 24px);\n        color: #fff;\n      }\n      .ogreen b {\n        font-weight: 700;\n      }\n      .nsb {\n        flex: none;\n        width: 74px;\n        height: 74px;\n        background: #fff;\n        border-radius: 14px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 8px;\n      }\n      .nsb img {\n        max-width: 100%;\n        max-height: 100%;\n        object-fit: contain;\n      }\n      @media (max-width: 560px) {\n        .ogreen {\n          flex-direction: column;\n          text-align: center;\n        }\n      }\n\n      .gnote {\n        font-family: var(--pop);\n        font-weight: 500;\n        font-size: clamp(13.5px, 1.9vw, 16px);\n        color: #cfd6d2;\n        line-height: 1.5;\n        margin-top: 2px;\n      }\n\n      /* traditional-vs-bfunded compare */\n      .cmp3 {\n        max-width: 760px;\n        margin: 0 auto;\n      }\n      .c3h,\n      .c3r {\n        display: grid;\n        grid-template-columns: 1.15fr 1fr 1fr;\n        gap: 10px;\n        align-items: center;\n      }\n      .c3h {\n        padding-bottom: 12px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.16);\n      }\n      .c3h span {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(16px, 2.4vw, 21px);\n        text-transform: uppercase;\n        letter-spacing: 0.06em;\n        color: #9aa39e;\n        text-align: center;\n      }\n      .c3h span:first-child {\n        text-align: left;\n      }\n      .c3h span.g {\n        color: var(--mint);\n      }\n      .c3r {\n        padding: 15px 0;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n      }\n      .c3r:last-of-type {\n        border-bottom: none;\n      }\n      .c3l {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(21px, 3vw, 26px);\n        color: #e8ecea;\n      }\n      .c3x,\n      .c3v {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(19px, 2.7vw, 23px);\n        text-align: center;\n      }\n      .c3x {\n        color: #8f8f8f;\n      }\n      .c3x::before {\n        content: \"\u2715  \";\n        color: #6e6e6e;\n      }\n      .c3v {\n        color: var(--mint);\n      }\n      .c3v::before {\n        content: \"\u2713  \";\n      }\n      .c3v b {\n        font-weight: 700;\n        color: var(--mint);\n      }\n      @media (max-width: 560px) {\n        .c3h,\n        .c3r {\n          grid-template-columns: 1fr 0.8fr 0.9fr;\n        }\n        .c3l {\n          font-size: 17px;\n        }\n      }\n\n      /* market bars */\n      .mb {\n        display: grid;\n        grid-template-columns: 250px 1fr 120px;\n        gap: 18px;\n        align-items: center;\n        padding: 12px 0;\n      }\n      .mn {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(13px, 1.9vw, 15.5px);\n        color: #e8ecea;\n      }\n      .mn em {\n        font-style: normal;\n        color: var(--gold2);\n      }\n      .mtr {\n        display: block;\n        height: 28px;\n        background: rgba(255, 255, 255, 0.07);\n        border-radius: 10px;\n        overflow: hidden;\n      }\n      .mtr i {\n        display: block;\n        height: 100%;\n        border-radius: 7px;\n        background: linear-gradient(90deg, #39c2c9aa, #a9ecda88);\n      }\n      .mtr i.g {\n        background: linear-gradient(90deg, #39c2c9, #a9ecda);\n      }\n      .mb b {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(16px, 2.3vw, 20px);\n        color: var(--gold2);\n        text-align: right;\n      }\n      .mb b.mut2 {\n        color: #9aa39e;\n      }\n      @media (max-width: 640px) {\n        .mb {\n          grid-template-columns: 110px 1fr 70px;\n        }\n        .mn {\n          white-space: normal;\n        }\n      }\n\n      /* search trend */\n      .trend {\n        width: 100%;\n        height: clamp(150px, 22vw, 200px);\n        display: block;\n      }\n      .tyrs {\n        display: flex;\n        justify-content: space-between;\n        margin-top: 10px;\n        font-family: var(--pop);\n        font-size: 17px;\n        font-weight: 600;\n        color: var(--dim);\n      }\n\n      /* stat triple */\n      .strip {\n        display: flex;\n        justify-content: center;\n        gap: clamp(24px, 7vw, 64px);\n        flex-wrap: wrap;\n        text-align: center;\n      }\n      .strip .st b {\n        display: block;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(32px, 5vw, 48px);\n        line-height: 1;\n        color: #fff;\n      }\n      .strip .st.g b {\n        color: var(--gold2);\n      }\n      .strip .st span {\n        display: block;\n        font-size: 17px;\n        font-weight: 600;\n        color: #9aa39e;\n        margin-top: 8px;\n      }\n\n      /* 50x polish: brand stamp + product-design finish */\n      .vc {\n        position: relative;\n      }\n\n      .pnl {\n        box-shadow:\n          inset 0 1px 0 rgba(255, 255, 255, 0.07),\n          0 24px 54px -30px rgba(22, 48, 43, 0.55) !important;\n        border-radius: 22px !important;\n      }\n      .pnl h3 {\n        letter-spacing: -0.01em;\n      }\n\n      /* odds pills - gradient border + big values */\n      .orow {\n        background:\n          linear-gradient(#3a3a3a, #3a3a3a) padding-box,\n          linear-gradient(120deg, #4a4a4a, #5c5c5c) border-box;\n        border: 1.5px solid transparent;\n        padding: 18px 26px;\n        font-size: clamp(20px, 2.9vw, 24px);\n      }\n      .orow.hot {\n        background:\n          linear-gradient(#31413a, #31413a) padding-box,\n          linear-gradient(120deg, #2fb583, #a9ecda) border-box;\n        border: 1.5px solid transparent;\n      }\n      .orow b {\n        font-size: clamp(24px, 3.4vw, 30px);\n      }\n      .orow.hot b {\n        font-size: clamp(27px, 3.8vw, 34px);\n      }\n\n      /* unlock - thicker arrows, bolder results */\n      .ur .arw path {\n        stroke-width: 5;\n      }\n      .ua {\n        font-size: clamp(22px, 3.3vw, 28px);\n      }\n      .ua b {\n        font-size: clamp(26px, 3.7vw, 33px);\n      }\n      .ua em {\n        width: 8px;\n        height: 34px;\n        border-radius: 5px;\n      }\n      .ur.done .ua b {\n        color: #fff;\n      }\n\n      /* two-panel + market bars - numerals up */\n\n      .mb b {\n        font-size: clamp(26px, 3.7vw, 33px);\n        white-space: nowrap;\n      }\n      .mtr {\n        height: 24px;\n        border-radius: 9px;\n      }\n      .mn {\n        font-size: clamp(20px, 3vw, 25px);\n        white-space: nowrap;\n      }\n\n      /* strip stats up */\n      .strip .st b {\n        font-size: clamp(36px, 5.6vw, 54px);\n      }\n\n      /* world map + lucide icons */\n      .wmap {\n        width: 100%;\n        height: auto;\n        display: block;\n        margin: 6px 0 18px;\n      }\n      .lic {\n        width: 19px;\n        height: 19px;\n        stroke: var(--mint);\n        fill: none;\n        stroke-width: 2;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n        vertical-align: -4px;\n        margin-right: 10px;\n        display: inline-block;\n      }\n\n      .pnl .brow,\n      .obody .orow,\n      .obody .ogreen {\n        max-width: 820px;\n        margin-left: auto;\n        margin-right: auto;\n      }\n      .pnl .brow {\n        padding-left: 8px;\n        padding-right: 8px;\n      }\n\n      /* intro email card */\n\n      .mfrom {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(18px, 2.5vw, 22px);\n        color: var(--gold);\n      }\n      .mto {\n        font-family: var(--pop);\n        font-weight: 500;\n        font-size: clamp(14px, 2vw, 17px);\n        color: #6b7a74;\n      }\n\n      /* master graphic-title size - identical in every graphic */\n      .vc h3,\n      .brk h3,\n      .cmp2 h3,\n      .grz .ct2,\n      .bko .big {\n        font-size: clamp(32px, 4vw, 52px) !important;\n        font-weight: 700 !important;\n        line-height: 1.22 !important;\n      }\n\n      /* time bars */\n      .tbars {\n        display: flex;\n        flex-direction: column;\n        gap: 26px;\n        max-width: 620px;\n        margin: 0 auto;\n      }\n      .tb {\n        display: grid;\n        grid-template-columns: 130px 1fr;\n        grid-template-rows: auto auto;\n        gap: 8px 18px;\n        align-items: center;\n      }\n      .tb .tlb {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(18px, 2.6vw, 24px);\n        color: #b9c2bd;\n        letter-spacing: 0.05em;\n        text-transform: uppercase;\n        grid-row: span 2;\n      }\n      .tb .tlb.g {\n        color: var(--gold2);\n      }\n      .tb .ttr {\n        display: block;\n        height: 26px;\n        background: rgba(255, 255, 255, 0.09);\n        border-radius: 9px;\n        overflow: hidden;\n      }\n      .tb .ttr i {\n        display: block;\n        height: 100%;\n        border-radius: 9px;\n        min-width: 10px;\n      }\n      .tb .ttr i.mut {\n        background: #5a5a5a;\n      }\n      .tb .ttr i.gld2 {\n        background: linear-gradient(90deg, var(--gold), #a9ecda);\n        box-shadow: 0 0 12px rgba(201, 164, 94, 0.3);\n      }\n      .tb b {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(19px, 2.8vw, 26px);\n        color: var(--gold2);\n      }\n      .tb b.mut2 {\n        color: #b9c2bd;\n      }\n      @media (max-width: 560px) {\n        .tb {\n          grid-template-columns: 1fr;\n        }\n        .tb .tlb {\n          grid-row: auto;\n        }\n      }\n\n      /* chart cards */\n      .chc {\n        background: var(--panel);\n        padding: 20px 14px 10px;\n      }\n      .chc .ct {\n        font-family: var(--pop);\n        color: #fff;\n        font-weight: 600;\n        font-size: 17px;\n        text-align: center;\n        margin-bottom: 6px;\n      }\n      .chart {\n        width: 100%;\n        height: 300px;\n      }\n\n      /* calculator */\n      .calc2 {\n        background: var(--cardiv);\n        border-radius: 14px;\n        padding: 30px 28px;\n        margin: 26px auto 0;\n        box-shadow: 0 18px 44px -30px rgba(30, 30, 20, 0.45);\n      }\n      .calc2 .lab {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        font-size: 17px;\n        font-weight: 700;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: #6b7a74;\n      }\n      .calc2 .amt {\n        background: #fdfbf5;\n        border: 1px solid #d9ebe1;\n        border-radius: 100px;\n        padding: 10px 22px;\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 20px;\n        color: var(--ink);\n      }\n      .calc2 input[type=\"range\"] {\n        width: 100%;\n        margin: 22px 0 4px;\n        accent-color: var(--gold);\n        cursor: pointer;\n      }\n      .calc2 .mm {\n        display: flex;\n        justify-content: space-between;\n        font-size: 17px;\n        color: #6b7a74;\n        font-weight: 600;\n      }\n      .calc2 .out {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        margin-top: 22px;\n        border-top: 1px solid #d9ebe1;\n        padding-top: 20px;\n      }\n      .calc2 .o {\n        text-align: center;\n        padding: 0 10px;\n      }\n      .calc2 .o + .o {\n        border-left: 1px solid #d9ebe1;\n      }\n      .calc2 .ok2 {\n        font-size: 17px;\n        font-weight: 700;\n        letter-spacing: 0.1em;\n        text-transform: uppercase;\n        color: #6b7a74;\n      }\n      .calc2 .ov2 {\n        font-family: var(--serif);\n        font-weight: 600;\n        font-size: clamp(30px, 4.4vw, 40px);\n        color: var(--ink);\n        margin-top: 6px;\n      }\n      .calc2 .os {\n        font-size: 17px;\n        color: #6b7a74;\n        margin-top: 4px;\n      }\n      .calc2 .disc {\n        text-align: center;\n        font-size: 17px;\n        color: #6b7a74;\n        margin-top: 18px;\n      }\n      .formula {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 12px;\n        margin: 22px auto 0;\n        font-family: var(--serif);\n        font-size: 17px;\n        color: #57544a;\n      }\n      .formula .fr {\n        display: flex;\n        flex-direction: column;\n        text-align: center;\n      }\n      .formula .fr span:first-child {\n        border-bottom: 1.5px solid #57544a;\n        padding: 0 8px 3px;\n      }\n      .formula .fr span:last-child {\n        padding-top: 3px;\n      }\n\n      /* numbered accordion */\n      .acc2 {\n        background: var(--cardiv);\n        border-radius: 14px;\n        margin: 26px auto 0;\n        overflow: hidden;\n        box-shadow: 0 18px 44px -30px rgba(30, 30, 20, 0.45);\n      }\n      .ai {\n        border-bottom: 1px solid #d9ebe1;\n      }\n      .ai:last-child {\n        border-bottom: none;\n      }\n      .ai .aih {\n        display: grid;\n        grid-template-columns: 34px 1fr auto;\n        gap: 8px;\n        align-items: center;\n        padding: 17px 22px;\n        cursor: pointer;\n      }\n      .ai .num {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 19px;\n        color: var(--gold);\n      }\n      .ai .aq {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(17px, 2.4vw, 21px);\n      }\n      .ai .at {\n        font-size: 17px;\n        color: var(--gold);\n        font-weight: 600;\n        white-space: nowrap;\n      }\n      .ai .ab {\n        max-height: 0;\n        overflow: hidden;\n        transition: max-height 0.35s ease;\n      }\n      .ai .ab p {\n        padding: 0 22px 18px 64px;\n        font-size: 17px;\n        color: #57544a;\n      }\n\n      /* perks table */\n      .perks {\n        background: var(--cardiv);\n        border-radius: 14px;\n        margin: 26px auto 0;\n        box-shadow: 0 18px 44px -30px rgba(30, 30, 20, 0.45);\n      }\n      .pk {\n        display: grid;\n        grid-template-columns: 150px 1fr;\n        gap: 14px;\n        align-items: center;\n        padding: 20px 26px;\n        border-bottom: 1px solid #d9ebe1;\n      }\n      .pk:last-child {\n        border-bottom: none;\n      }\n      .pk .pv2 {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(20px, 3vw, 26px);\n        color: var(--gold);\n      }\n      .pk .pt2 {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(18px, 2.6vw, 23px);\n      }\n      .pk .pt2 small {\n        display: block;\n        font-family: var(--sans);\n        font-weight: 500;\n        color: var(--dim);\n        font-size: 17px;\n        margin-top: 2px;\n      }\n      @media (max-width: 520px) {\n        .pk {\n          grid-template-columns: 1fr;\n          gap: 4px;\n        }\n      }\n\n      /* ledger mini */\n      .led {\n        background: var(--cardiv);\n        border-radius: 14px;\n        margin: 26px auto 0;\n        overflow: hidden;\n        box-shadow: 0 18px 44px -30px rgba(30, 30, 20, 0.45);\n      }\n      .ld {\n        display: grid;\n        grid-template-columns: 0.9fr 1.4fr;\n        gap: 12px;\n        padding: 15px 24px;\n        border-bottom: 1px solid #d9ebe1;\n        align-items: center;\n      }\n      .ld:last-child {\n        border-bottom: none;\n      }\n      .ld .q2 {\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: clamp(17px, 2.4vw, 21px);\n      }\n      .ld .a2 {\n        font-size: clamp(14.5px, 2vw, 17px);\n        color: #57544a;\n        font-weight: 500;\n      }\n      .ld.open2 {\n        background: var(--panel);\n      }\n      .ld.open2 .q2 {\n        color: var(--gold2);\n      }\n      .ld.open2 .a2 {\n        color: #e8ecea;\n      }\n      @media (max-width: 560px) {\n        .ld {\n          grid-template-columns: 1fr;\n          gap: 3px;\n        }\n      }\n\n      /* nav + deadline */\n      .nav {\n        position: sticky;\n        top: 0;\n        z-index: 100;\n        background: rgba(245, 241, 232, 0.92);\n        backdrop-filter: blur(12px);\n      }\n      .nav-in {\n        max-width: 1460px;\n        margin: 0 auto;\n        padding: 13px 22px;\n        display: flex;\n        align-items: center;\n        gap: 18px;\n      }\n      .nav img {\n        height: 24px;\n      }\n      .nav-r {\n        margin-left: auto;\n        display: flex;\n        gap: 18px;\n        align-items: center;\n        font-size: 17px;\n        font-weight: 600;\n        color: #57544a;\n      }\n      @media (max-width: 700px) {\n        .nav-r a.l {\n          display: none;\n        }\n      }\n      .cta {\n        display: inline-block;\n        background: var(--ink);\n        color: #fff;\n        font-family: var(--pop);\n        font-weight: 600;\n        font-size: 17px;\n        padding: 9px 20px;\n        border-radius: 100px;\n        border: none;\n        cursor: pointer;\n        transition: transform 0.15s;\n      }\n      .cta:hover {\n        transform: translateY(-1px);\n      }\n      .cta.gold {\n        background: var(--goldfill);\n        color: #fff;\n      }\n      .dead {\n        position: sticky;\n        top: 64px;\n        z-index: 99;\n        background: #ddf0e6;\n        border-top: 1px solid #c6e4d4;\n        border-bottom: 1px solid #c6e4d4;\n        padding: 8px 0;\n      }\n      .dead-in {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 16px;\n      }\n      .dead .dl2 {\n        font-size: 17px;\n        font-weight: 700;\n        letter-spacing: 0.16em;\n        color: var(--gold);\n        text-transform: uppercase;\n      }\n      .dead .du {\n        text-align: center;\n      }\n      .dead .du b {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: 17px;\n        display: block;\n        line-height: 1;\n      }\n      .dead .du span {\n        font-size: 17px;\n        letter-spacing: 0.1em;\n        color: #6b7a74;\n        font-weight: 700;\n        text-transform: uppercase;\n      }\n      .dead .dot2 {\n        color: #9fc4b3;\n        font-weight: 700;\n      }\n\n      /* hero */\n      .hero2 {\n        padding: 54px 0 60px;\n      }\n      .hero2 .grid {\n        max-width: 1440px;\n        margin: 0 auto;\n        padding: 0 32px;\n        display: grid;\n        grid-template-columns: 1.05fr 1fr;\n        gap: 64px;\n        align-items: center;\n      }\n      .hero2 h1 {\n        font-family: var(--pop);\n        font-weight: 700;\n        font-size: clamp(34px, 3.5vw, 56px);\n        line-height: 1.16;\n        letter-spacing: -0.015em;\n      }\n      .hero2 h1 em {\n        font-style: normal;\n        color: var(--gold);\n      }\n      .hero2 .tr {\n        font-size: 17px;\n        font-weight: 700;\n        letter-spacing: 0.16em;\n        text-transform: uppercase;\n        color: var(--gold);\n        margin: 18px 0 6px;\n      }\n      .hero2 .ck {\n        display: flex;\n        align-items: center;\n        gap: 13px;\n        padding: 15px 0;\n        border-bottom: 1px solid #cde7da;\n        font-size: clamp(15px, 1.18vw, 18px);\n        line-height: 1.3;\n        font-weight: 600;\n        color: #3c392f;\n        white-space: nowrap;\n      }\n      .hero2 .ck:last-of-type {\n        border-bottom: none;\n      }\n      .hero2 .ck i {\n        flex: none;\n        width: 22px;\n        height: 22px;\n        border-radius: 50%;\n        background: var(--gold);\n        position: relative;\n      }\n      .hero2 .ck i::after {\n        content: \"\";\n        position: absolute;\n        left: 8px;\n        top: 5px;\n        width: 5px;\n        height: 9px;\n        border-right: 2px solid #fff;\n        border-bottom: 2px solid #fff;\n        transform: rotate(45deg);\n      }\n      .hero2 .cta {\n        margin-top: 22px;\n      }\n      .film2 {\n        border-radius: 14px;\n        overflow: hidden;\n        box-shadow: 0 26px 60px -30px rgba(30, 30, 20, 0.55);\n        background: #000;\n      }\n      .film2 video {\n        width: 