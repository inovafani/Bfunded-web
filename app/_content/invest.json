         e.textContent = t;\n          });\n        }\n        u();\n        setInterval(u, 3e4);\n      })();\n      // animate bars & fills as they scroll in\n      (function () {\n        function grow(el, prop) {\n          var inline = el.style[prop];\n          var target = inline || getComputedStyle(el)[prop];\n          if (!target || target === \"auto\") return;\n          var zero = (\"\" + target).indexOf(\"%\") > -1 && inline ? \"0%\" : \"0px\";\n          el.style.transition = \"none\";\n          el.style[prop] = zero;\n          void el.offsetWidth;\n          el.style.transition = prop + \" 1.1s cubic-bezier(.22,.75,.2,1) .18s\";\n          el.style[prop] = target;\n          setTimeout(function () {\n            el.style.transition = \"\";\n            el.style[prop] = inline;\n          }, 1600);\n        }\n        var bio = new IntersectionObserver(\n          function (es) {\n            es.forEach(function (e) {\n              if (!e.isIntersecting) return;\n              bio.unobserve(e.target);\n              e.target\n                .querySelectorAll(\".d3b i,.bars .bar,.gbar,.accbar,.dpc i\")\n                .forEach(function (b) {\n                  grow(b, \"height\");\n                });\n              e.target.querySelectorAll(\".mtr i,.abar i\").forEach(function (b) {\n                grow(b, \"width\");\n              });\n            });\n          },\n          { threshold: 0.25 },\n        );\n        document.querySelectorAll(\".vc,.bigcta\").forEach(function (c) {\n          if (c.hasAttribute(\"data-noanim\")) return;\n          if (c.querySelector(\".d3b i,.bars .bar,.mtr i,.abar i\"))\n            bio.observe(c);\n        });\n      })();\n      // reveal\n      const io = new IntersectionObserver(\n        (es) =>\n          es.forEach((e) => {\n            if (e.isIntersecting) {\n              e.target.classList.add(\"v\");\n              io.unobserve(e.target);\n            }\n          }),\n        { threshold: 0.1, rootMargin: \"-20px\" },\n      );\n      document.querySelectorAll(\".rv\").forEach((e) => io.observe(e));\n      // calculator\n      (function () {\n        var r = document.getElementById(\"crange\");\n        if (!r) return;\n        function money(v) {\n          return \"$\" + v.toLocaleString(\"en-US\");\n        }\n        function fmt(v) {\n          return v >= 1e6\n            ? \"$\" + (v / 1e6).toFixed(2).replace(/\\.?0+$/, \"\") + \"M\"\n            : \"$\" + Math.round(v / 1e3) + \"K\";\n        }\n        function upd() {\n          var v = +r.value;\n          document.getElementById(\"camt\").textContent = money(v);\n\n          document.getElementById(\"cpct\").textContent =\n            ((v / 4e6) * 100)\n              .toFixed(v >= 2e4 ? 2 : 3)\n              .replace(/0+$/, \"\")\n              .replace(/\\.$/, \"\") + \"%\";\n          document.getElementById(\"cval\").textContent = fmt(v * 62.5);\n        }\n        r.addEventListener(\"input\", upd);\n        upd();\n      })();\n      // accordions\n      document.querySelectorAll(\".aih\").forEach((h) =>\n        h.addEventListener(\"click\", () => {\n          const b = h.parentElement.querySelector(\".ab\");\n          b.style.maxHeight =\n            b.style.maxHeight && b.style.maxHeight !== \"0px\"\n              ? 0\n              : b.scrollHeight + \"px\";\n        }),\n      );\n      document.querySelectorAll(\".fqh\").forEach((h) =>\n        h.addEventListener(\"click\", () => {\n          const q = h.parentElement,\n            a = q.querySelector(\".fqa\"),\n            o = q.classList.toggle(\"open\");\n          a.style.maxHeight = o ? a.scrollHeight + \"px\" : 0;\n        }),\n      );\n      // form\n      (function () {\n        const f = document.getElementById(\"cform\");\n        if (!f) return;\n        f.addEventListener(\"submit\", function (e) {\n          e.preventDefault();\n          const btn = f.querySelector(\"button[type=submit]\");\n          btn.disabled = true;\n          btn.style.opacity = 0.6;\n          const mailFallback = () => {\n            const n = (f.elements[\"name\"] && f.elements[\"name\"].value) || \"\";\n            location.href =\n              \"mailto:invest@bfunded.io?subject=\" +\n              encodeURIComponent(\"Investor-partner: \" + n);\n          };\n          fetch(\"/\", {\n            method: \"POST\",\n            headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" },\n            body: new URLSearchParams(new FormData(f)).toString(),\n          })\n            .then((r) => {\n              if (!r.ok) return mailFallback();\n              document.getElementById(\"fok\").style.display = \"block\";\n              f.querySelectorAll(\"input:not([type=hidden]),select\").forEach(\n                (i) => (i.value = \"\"),\n              );\n              btn.textContent = \"\u2713 Request received\";\n            })\n            .catch(mailFallback)\n            .finally(() => {\n              btn.disabled = false;\n              btn.style.opacity = 1;\n            });\n        });\n      })();\n    </script>\n    <script\n      src=\"https://unpkg.com/rough-notation@0.5.1/lib/rough-notation.iife.js\"\n      defer\n    ></script>\n    <script>\n      addEventListener(\"DOMContentLoaded\", function () {\n        function go() {\n          if (!window.RoughNotation) return;\n          var rm = matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n          var A = RoughNotation.annotate,\n            cfg = [\n              [\n                document.getElementById(\"rn-odds\"),\n                {\n                  type: \"circle\",\n                  color: \"#3ec28f\",\n                  strokeWidth: 3,\n                  padding: 8,\n                },\n              ],\n              [\n                document.getElementById(\"rn-left\"),\n                {\n                  type: \"underline\",\n                  color: \"#a9ecda\",\n                  strokeWidth: 4,\n                  padding: 3,\n                },\n              ],\n            ];\n          cfg.forEach(function (c) {\n            var el = c[0];\n            if (!el) return;\n            var o = Object.assign(\n              { animate: !rm, animationDuration: 900, multiline: true },\n              c[1],\n            );\n            new IntersectionObserver(\n              function (es, io) {\n                es.forEach(function (e) {\n                  if (e.isIntersecting) {\n                    io.disconnect();\n                    setTimeout(function () {\n                      A(el, o).show();\n                    }, 1050);\n                  }\n                });\n              },\n              { threshold: 0.7 },\n            ).observe(el);\n          });\n        }\n        var t = setInterval(function () {\n          if (window.RoughNotation) {\n            clearInterval(t);\n            go();\n          }\n        }, 150);\n        setTimeout(function () {\n          clearInterval(t);\n        }, 6000);\n      });\n    </script>\n  "