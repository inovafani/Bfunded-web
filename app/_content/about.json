"<style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      :root {\n        --ink: #000;\n        --paper: #fff;\n        --muted: #8b8b8b;\n        --rule: rgba(255, 255, 255, 0.12);\n        --mint: #d6f2e4;\n        --accent: #3ec28f;\n      }\n      html {\n        scroll-behavior: smooth;\n        -webkit-text-size-adjust: 100%;\n      }\n      body {\n        background: var(--ink);\n        color: var(--paper);\n        font-family: \"DM Sans\", Inter, Arial, sans-serif;\n        font-weight: 400;\n        line-height: 1.5;\n        -webkit-font-smoothing: antialiased;\n      }\n      img,\n      video {\n        max-width: 100%;\n        display: block;\n      }\n      a {\n        color: inherit;\n        text-decoration: none;\n      }\n      .wrap {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: 0 32px;\n      }\n\n      /* nav */\n      .nav {\n        position: sticky;\n        top: 0;\n        z-index: 50;\n        background: rgba(0, 0, 0, 0.82);\n        backdrop-filter: blur(14px);\n      }\n      .nav-in {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: 20px 32px;\n        display: flex;\n        align-items: center;\n        gap: 20px;\n      }\n      .nav img {\n        height: 34px;\n      }\n      .nav-r {\n        margin-left: auto;\n        display: flex;\n        align-items: center;\n        gap: 32px;\n        font-size: 15px;\n        color: #cfcfcf;\n      }\n      .nav-r a.l:hover {\n        color: #fff;\n      }\n      .nav-cta {\n        border: 1px solid rgba(255, 255, 255, 0.35);\n        border-radius: 100px;\n        padding: 11px 24px;\n        font-size: 15px;\n        color: #fff;\n      }\n      .nav-cta:hover {\n        background: #fff;\n        color: #000;\n      }\n      @media (max-width: 860px) {\n        .nav-r a.l {\n          display: none;\n        }\n        .nav-in {\n          padding: 16px 22px;\n        }\n      }\n\n      /* hero */\n      .hero {\n        position: relative;\n        min-height: 78vh;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        text-align: center;\n        overflow: hidden;\n      }\n      .hero > img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n      }\n      .hero .veil {\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(\n          180deg,\n          rgba(0, 0, 0, 0.6),\n          rgba(0, 0, 0, 0.45) 45%,\n          rgba(0, 0, 0, 0.85)\n        );\n      }\n      .hero .in {\n        position: relative;\n        padding: 120px 32px;\n      }\n      h1 {\n        font-weight: 400;\n        letter-spacing: -0.03em;\n        line-height: 1.02;\n        font-size: clamp(44px, 7.2vw, 104px);\n      }\n      .hero p {\n        margin: 28px auto 0;\n        max-width: 620px;\n        font-size: clamp(17px, 1.5vw, 21px);\n        color: #c9c9c9;\n        font-weight: 400;\n      }\n\n      /* sections */\n      section {\n        padding: clamp(80px, 10vw, 150px) 0;\n        scroll-margin-top: 90px;\n      }\n      .eyebrow {\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n        color: var(--accent);\n        font-weight: 600;\n        margin-bottom: 22px;\n      }\n      h2 {\n        font-weight: 400;\n        letter-spacing: -0.025em;\n        line-height: 1.06;\n        font-size: clamp(34px, 5vw, 72px);\n      }\n      .lede {\n        margin-top: 26px;\n        max-width: 680px;\n        font-size: clamp(17px, 1.5vw, 21px);\n        color: #b4b4b4;\n        line-height: 1.6;\n      }\n\n      /* three-up, no boxes */\n      .trio {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(28px, 4vw, 64px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .trio .n {\n        font-size: 15px;\n        color: var(--accent);\n        font-family: Inter, sans-serif;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n      }\n      .trio h3 {\n        margin-top: 20px;\n        font-size: clamp(21px, 2vw, 28px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n        line-height: 1.25;\n      }\n      .trio p {\n        margin-top: 14px;\n        font-size: 16px;\n        color: #9a9a9a;\n        line-height: 1.65;\n      }\n      @media (max-width: 800px) {\n        .trio {\n          grid-template-columns: 1fr;\n          gap: 40px;\n        }\n      }\n\n      /* numbered steps as type, not boxes */\n      .steps {\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid var(--rule);\n      }\n      .step {\n        display: grid;\n        grid-template-columns: 70px 1fr 200px;\n        gap: 28px;\n        align-items: baseline;\n        padding: clamp(26px, 3vw, 40px) 0;\n        border-bottom: 1px solid var(--rule);\n      }\n      .step .i {\n        font-family: Inter, sans-serif;\n        font-size: 14px;\n        color: var(--muted);\n        letter-spacing: 0.08em;\n      }\n      .step h3 {\n        font-size: clamp(20px, 2.2vw, 32px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      }\n      .step .r {\n        text-align: right;\n        font-size: 15px;\n        color: var(--accent);\n        font-family: Inter, sans-serif;\n        letter-spacing: 0.02em;\n      }\n      @media (max-width: 800px) {\n        .step {\n          grid-template-columns: 44px 1fr;\n          gap: 16px;\n        }\n        .step .r {\n          grid-column: 2;\n          text-align: left;\n          margin-top: 8px;\n        }\n      }\n\n      /* stat line */\n      .stats {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(24px, 4vw, 56px);\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid var(--rule);\n        padding-top: clamp(36px, 4vw, 56px);\n      }\n      .stat b {\n        display: block;\n        font-size: clamp(40px, 5.4vw, 76px);\n        font-weight: 300;\n        letter-spacing: -0.035em;\n        line-height: 1;\n      }\n      .stat span {\n        display: block;\n        margin-top: 14px;\n        font-size: 15px;\n        color: #9a9a9a;\n        line-height: 1.5;\n      }\n      @media (max-width: 800px) {\n        .stats {\n          grid-template-columns: 1fr;\n          gap: 32px;\n        }\n      }\n\n      /* team */\n      .team {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(24px, 3vw, 44px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .person img {\n        width: 100%;\n        aspect-ratio: 0.82;\n        object-fit: cover;\n        border-radius: 4px;\n        filter: grayscale(100%);\n        transition: filter 0.5s ease;\n      }\n      .person:hover img {\n        filter: grayscale(0);\n      }\n      .person h3 {\n        margin-top: 24px;\n        font-size: clamp(20px, 1.8vw, 26px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      }\n      .person .role {\n        margin-top: 6px;\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--accent);\n      }\n      .person p {\n        margin-top: 16px;\n        font-size: 15px;\n        color: #9a9a9a;\n        line-height: 1.65;\n      }\n      @media (max-width: 800px) {\n        .team {\n          grid-template-columns: 1fr;\n          gap: 48px;\n          max-width: 420px;\n        }\n      }\n\n      /* mint band */\n      .band {\n        background: var(--mint);\n        color: #0b0b0b;\n      }\n      .band .eyebrow {\n        color: #1d7a57;\n      }\n      .band .lede {\n        color: #3b4a44;\n      }\n\n      /* close */\n      .close {\n        text-align: center;\n      }\n      .close h2 {\n        max-width: 14ch;\n        margin: 0 auto;\n      }\n      .close .go {\n        display: inline-block;\n        margin-top: 44px;\n        border: 1px solid rgba(255, 255, 255, 0.4);\n        border-radius: 100px;\n        padding: 19px 46px;\n        font-size: 17px;\n        letter-spacing: 0.01em;\n      }\n      .close .go:hover {\n        background: #fff;\n        color: #000;\n      }\n      .close .sub {\n        margin-top: 22px;\n        font-size: 15px;\n        color: var(--muted);\n      }\n\n      footer {\n        border-top: 1px solid var(--rule);\n        padding: 56px 0 72px;\n        font-size: 14px;\n        color: var(--muted);\n      }\n      footer .fin {\n        display: flex;\n        justify-content: space-between;\n        gap: 20px;\n        flex-wrap: wrap;\n      }\n      footer .disc {\n        max-width: 720px;\n        margin-bottom: 26px;\n        line-height: 1.7;\n      }\n\n      /* full-bleed origin band */\n      .origin {\n        position: relative;\n        overflow: hidden;\n        padding: 0;\n      }\n      .origin > img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        object-position: 82% center;\n      }\n      .origin .veil {\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(\n          96deg,\n          rgba(0, 0, 0, 0.93) 0%,\n          rgba(0, 0, 0, 0.8) 40%,\n          rgba(0, 0, 0, 0.34) 100%\n        );\n      }\n      .origin .in {\n        position: relative;\n        padding: clamp(88px, 11vw, 168px) 32px;\n      }\n      .origin .ohold {\n        max-width: 680px;\n      }\n\n      /* the companies we started with */\n      .cases {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(30px, 4vw, 60px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .lgbox {\n        height: 74px;\n        display: flex;\n        align-items: center;\n      }\n      .lg {\n        max-height: 74px;\n        max-width: 168px;\n        width: auto;\n        object-fit: contain;\n      }\n      .case .tag {\n        margin-top: 26px;\n        font-family: Inter, sans-serif;\n        font-size: 12px;\n        letter-spacing: 0.13em;\n        text-transform: uppercase;\n        color: var(--accent);\n        font-weight: 600;\n      }\n      .case {\n        display: flex;\n        flex-direction: column;\n      }\n      .case p {\n        margin-top: 14px;\n        font-size: 16px;\n        color: #9a9a9a;\n        line-height: 1.65;\n        min-height: 106px;\n      }\n      .case blockquote {\n        margin-top: 26px;\n        padding-top: 26px;\n        border-top: 1px solid var(--rule);\n        font-size: clamp(16px, 1.4vw, 18px);\n        line-height: 1.55;\n        color: #e8e8e8;\n      }\n      .case cite {\n        display: block;\n        margin-top: 14px;\n        font-style: normal;\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        color: var(--muted);\n      }\n      @media (max-width: 820px) {\n        .cases {\n          grid-template-columns: 1fr;\n          gap: 54px;\n        }\n        .case p {\n          min-height: 0;\n        }\n      }\n\n      /* then / now ledger */\n      .ledger {\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid rgba(0, 0, 0, 0.14);\n      }\n      .lrow {\n        display: grid;\n        grid-template-columns: 1fr 46px 1fr;\n        gap: clamp(16px, 3vw, 44px);\n        align-items: center;\n        padding: clamp(24px, 2.8vw, 38px) 0;\n        border-bottom: 1px solid rgba(0, 0, 0, 0.14);\n      }\n      .lrow .was {\n        font-size: clamp(17px, 1.85vw, 25px);\n        color: #5f7269;\n        line-height: 1.3;\n      }\n      .lrow .arw {\n        text-align: center;\n        color: #1d7a57;\n        font-size: 20px;\n      }\n      .lrow .now {\n        font-size: clamp(17px, 1.85vw, 25px);\n        color: #0b0b0b;\n        line-height: 1.3;\n      }\n      @media (max-width: 820px) {\n        .lrow {\n          grid-template-columns: 1fr;\n          gap: 5px;\n          padding: 22px 0;\n        }\n        .lrow .arw {\n          text-align: left;\n          font-size: 16px;\n          line-height: 1;\n        }\n      }\n\n      /* founders, leading the page */\n      .fdr {\n        display: grid;\n        grid-template-columns: minmax(0, 38%) minmax(0, 62%);\n        gap: clamp(30px, 4.5vw, 72px);\n        align-items: start;\n        padding: clamp(46px, 5vw, 76px) 0;\n        border-top: 1px solid var(--rule);\n      }\n      .fdr:first-of-type {\n        margin-top: clamp(46px, 5vw, 76px);\n      }\n      .fdr.flip {\n        grid-template-columns: minmax(0, 62%) minmax(0, 38%);\n      }\n      .fdr.flip .fpic {\n        order: 2;\n      }\n      .fdr.flip .fbody {\n        order: 1;\n      }\n      .fpic img {\n        width: 100%;\n        aspect-ratio: 0.86;\n        object-fit: cover;\n        border-radius: 4px;\n        filter: grayscale(100%);\n        transition: filter 0.6s ease;\n      }\n      .fdr:hover .fpic img {\n        filter: grayscale(0);\n      }\n      .fbody h3 {\n        font-size: clamp(28px, 3.4vw, 48px);\n        font-weight: 400;\n        letter-spacing: -0.025em;\n        line-height: 1.05;\n      }\n      .frole {\n        margin-top: 12px;\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--accent);\n      }\n      .fbody p {\n        margin-top: 22px;\n        font-size: clamp(16px, 1.35vw, 18px);\n        color: #a8a8a8;\n        line-height: 1.72;\n        max-width: 60ch;\n      }\n      .fstats {\n        display: flex;\n        flex-wrap: wrap;\n        gap: clamp(20px, 3vw, 48px);\n        margin-top: 32px;\n        padding-top: 26px;\n        border-top: 1px solid var(--rule);\n      }\n      .fstats span {\n        display: flex;\n        flex-direction: column;\n        font-size: 13.5px;\n        color: #8b8b8b;\n        line-height: 1.4;\n        max-width: 15ch;\n      }\n      .fstats b {\n        font-size: clamp(24px, 2.4vw, 34px);\n        font-weight: 300;\n        letter-spacing: -0.03em;\n        color: #fff;\n        margin-bottom: 8px;\n      }\n      @media (max-width: 860px) {\n        .fdr,\n        .fdr.flip {\n          grid-template-columns: 1fr;\n          gap: 28px;\n        }\n        .fdr.flip .fpic {\n          order: 1;\n        }\n        .fdr.flip .fbody {\n          order: 2;\n        }\n        .fpic img {\n          aspect-ratio: 1.25;\n        }\n        .fbody p {\n          max-width: none;\n        }\n      }\n\n      /* mission */\n      .mission {\n        position: relative;\n        overflow: hidden;\n        padding: 0;\n        text-align: center;\n      }\n      .mission > img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        opacity: 0.6;\n      }\n      .mveil {\n        position: absolute;\n        inset: 0;\n        background: radial-gradient(\n          120% 90% at 50% 50%,\n          rgba(0, 0, 0, 0.3),\n          rgba(0, 0, 0, 0.88) 72%\n        );\n      }\n      .mission .wrap {\n        position: relative;\n      }\n      .mission .min {\n        padding: clamp(110px, 14vw, 210px) 32px;\n      }\n      .mission h2 {\n        font-size: clamp(38px, 6.4vw, 92px);\n        letter-spacing: -0.03em;\n        line-height: 1.03;\n        max-width: 20ch;\n        margin: 0 auto;\n      }\n      .mission .lede {\n        margin: 38px auto 0;\n        max-width: 720px;\n        color: #c2c2c2;\n      }\n      .mission .eyebrow {\n        margin-bottom: 26px;\n      }\n\n      /* story: sticky visual, scrolling chapters */\n      .scroller {\n        display: grid;\n        grid-template-columns: minmax(0, 46%) minmax(0, 54%);\n        gap: clamp(32px, 5vw, 84px);\n        margin-top: clamp(48px, 6vw, 84px);\n        align-items: start;\n      }\n      .svis {\n        position: sticky;\n        top: 0;\n        height: 100vh;\n        display: flex;\n        align-items: center;\n      }\n      .vstack {\n        position: relative;\n        width: 100%;\n        height: clamp(400px, 44vw, 580px);\n        border-radius: 5px;\n        overflow: hidden;\n      }\n      .vis {\n        position: absolute;\n        inset: 0;\n        opacity: 0;\n        transform: scale(1.04);\n        transition:\n          opacity 0.8s ease,\n          transform 1.2s ease;\n      }\n      .vis.on {\n        opacity: 1;\n        transform: none;\n      }\n      .vis img {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n      }\n      .sblock {\n        min-height: 78vh;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        opacity: 0.26;\n        transition: opacity 0.5s ease;\n      }\n      .sblock.on {\n        opacity: 1;\n      }\n      .cno {\n        font-family: Inter, sans-serif;\n        font-size: 12px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n        color: var(--accent);\n        font-weight: 600;\n      }\n      .sblock h3 {\n        margin-top: 18px;\n        font-size: clamp(26px, 3.1vw, 44px);\n        font-weight: 400;\n        letter-spacing: -0.025em;\n        line-height: 1.08;\n      }\n      .sblock p {\n        margin-top: 20px;\n        font-size: clamp(16px, 1.4vw, 19px);\n        color: #a8a8a8;\n        line-height: 1.72;\n        max-width: 52ch;\n      }\n      @media (max-width: 900px) {\n        .scroller {\n          grid-template-columns: 1fr;\n          gap: 0;\n        }\n        .svis {\n          position: sticky;\n          top: 76px;\n          height: auto;\n          display: block;\n          padding: 12px 0 10px;\n          background: linear-gradient(180deg, #000 80%, transparent);\n          z-index: 2;\n        }\n        .vstack {\n          height: clamp(240px, 54vw, 320px);\n        }\n        .sblock {\n          min-height: 0;\n          opacity: 1;\n          padding: 34px 0;\n        }\n        .sblock p {\n          max-width: none;\n        }\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .vis {\n          transition: none;\n        }\n        .sblock {\n          opacity: 1;\n        }\n      }\n\n      .rise {\n        opacity: 0;\n        transform: translateY(22px);\n        transition:\n          opacity 0.8s cubic-bezier(0.22, 0.75, 0.2, 1),\n          transform 0.8s cubic-bezier(0.22, 0.75, 0.2, 1);\n      }\n      .rise.on {\n        opacity: 1;\n        transform: none;\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .rise {\n          opacity: 1;\n          transform: none;\n          transition: none;\n        }\n      }\n    </style>\n\n    <nav class=\"nav\">\n      <div class=\"nav-in\">\n        <a href=\"/\"\n          ><img src=\"/assets/home/logo-white.svg\" alt=\"BFunded\"\n        /></a>\n        <div class=\"nav-r\">\n          <a href=\"#founders\" class=\"l\">Founders</a>\n          <a href=\"#mission\" class=\"l\">Mission</a>\n          <a href=\"#story\" class=\"l\">Our Story</a>\n          <a href=\"#network\" class=\"l\">Network</a>\n          <a href=\"mailto:hello@bfunded.io\" class=\"nav-cta\">Get In Touch</a>\n        </div>\n      </div>\n    </nav>\n\n    <header class=\"hero\">\n      <img src=\"/assets/home/band-forest.jpg\" alt=\"\" />\n      <div class=\"veil\"></div>\n      <div class=\"in\">\n        <h1 class=\"rise\">We Score Founders.<br />Not Pitch Decks.</h1>\n        <p class=\"rise\">\n          Fundability is a quality of the founder, not the deck.\n        </p>\n      </div>\n    </header>\n\n    <section id=\"founders\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">The Founders</div>\n        <h2 class=\"rise\" style=\"max-width: 19ch\">\n          Three founders. Years on the capital side. Too many good ones never\n          funded.\n        </h2>\n        <p class=\"lede rise\">\n          Spotting a winning founder should not take a team of analysts. The\n          founder is the strongest signal there is, so we turned it into a\n          score.\n        </p>\n\n        <div class=\"fdr rise\">\n          <div class=\"fpic\">\n            <img src=\"/assets/home/jeff-io.png\" alt=\"Jeff Wenzel\" />\n          </div>\n          <div class=\"fbody\">\n            <h3>Jeff Wenzel</h3>\n            <div class=\"frole\">Co-Founder &amp; Chief Executive Officer</div>\n            <p>\n              Jeff has run more than 170 equity crowdfunding campaigns over a\n              decade and raised over $100M for early-stage founders. Before\n              that, 300+ Kickstarter launches. Along the way he has put a raise\n              in front of more than 850,000 investors, and he writes and teaches\n              publicly on Reg CF and equity crowdfunding.\n            </p>\n            <p>\n              What a decade of that work gives you is a very unsentimental view\n              of what actually closes a round. Two founders arrive with the same\n              market, the same numbers, the same deck template. One closes in\n              six weeks. The other spends nine months and gives up. Jeff built\n              BFunded to measure the difference the deck never showed.\n            </p>\n            <div class=\"fstats\">\n              <span><b>$100M+</b>raised for founders</span\n              ><span><b>170+</b>campaigns run</span\n              ><span><b>850K+</b>investors reached</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"fdr flip rise\">\n          <div class=\"fpic\">\n            <img src=\"/assets/home/will-io.png\" alt=\"William DiRicco\" />\n          </div>\n          <div class=\"fbody\">\n            <h3>William DiRicco</h3>\n            <div class=\"frole\">Chief Operating Officer</div>\n            <p>\n              William has raised $11M for early-stage companies and returned\n              10&times; to their earliest investors through secondaries. He has\n              closed $15M in brand deals with Gucci, Nike and Ray-Ban, and run\n              multiple campaigns that finished in the top 1% of the platforms\n              they launched on.\n            </p>\n            <p>\n              He also built Indonesia&rsquo;s largest trash-bank network, which\n              is the line that explains the rest of him. William is at his best\n              taking the thing everyone else has written off, and finding the\n              people who will pay for it. That is the same instinct a founder\n              needs when every fund in the market has passed.\n            </p>\n            <div class=\"fstats\">\n              <span><b>$11M</b>raised</span\n              ><span><b>10&times;</b>returned via secondaries</span\n              ><span><b>$15M</b>in brand deals</span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"fdr rise\">\n          <div class=\"fpic\">\n            <img src=\"/assets/home/anthony-crop.jpg\" alt=\"Anthony Cargill\" />\n          </div>\n          <div class=\"fbody\">\n            <h3>Anthony Cargill</h3>\n            <div class=\"frole\">Chief Marketing Officer</div>\n            <p>\n              Anthony has spent 12+ years scaling startups and agencies across\n              multiple verticals, including go-to-market for a unicorn AI\n              security company and cross-border commerce and accelerator\n              programmes across the US and Asia.\n            </p>\n            <p>\n              He has sat on both sides of the table through crowdfunding rounds\n              and venture rounds, which is a useful thing in a company whose\n              whole argument is that the table is set wrong.\n            </p>\n            <div class=\"fstats\">\n              <span><b>12+ yrs</b>scaling startups</span\n              ><span><b>Unicorn</b>AI security GTM</span\n              ><span><b>US/Asia</b>cross-border commerce</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"mission\" class=\"mission\">\n      <img src=\"/assets/home/bg-trail.jpg\" alt=\"\" />\n      <div class=\"mveil\"></div>\n      <div class=\"wrap min\">\n        <div class=\"eyebrow rise\">Our Mission</div>\n        <h2 class=\"rise\">Capital should follow evidence.<br />Not access.</h2>\n        <p class=\"lede rise\">\n          More great founders funded. Matched to the investors best suited to\n          back them. Because innovation should not wait on an introduction.\n        </p>\n      </div>\n    </section>\n\n    <section id=\"story\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">Our Story</div>\n        <h2 class=\"rise\" style=\"max-width: 15ch\">\n          How we got from a pile of decks to a million investors.\n        </h2>\n\n        <div class=\"scroller\">\n          <div class=\"svis\">\n            <div class=\"vstack\">\n              <div class=\"vis on\" data-i=\"0\">\n                <img src=\"/assets/home/decks-gold.jpg\" alt=\"\" />\n              </div>\n              <div class=\"vis\" data-i=\"1\">\n                <img src=\"/assets/home/decks-vc.jpg\" alt=\"\" />\n              </div>\n              <div class=\"vis\" data-i=\"2\">\n                <img src=\"/assets/home/band-seedling.jpg\" alt=\"\" />\n              </div>\n              <div class=\"vis\" data-i=\"3\">\n                <img src=\"/assets/home/bg-hourglass.jpg\" alt=\"\" />\n              </div>\n              <div class=\"vis\" data-i=\"4\">\n                <img src=\"/assets/home/band-path.jpg\" alt=\"\" />\n              </div>\n              <div class=\"vis\" data-i=\"5\">\n                <img src=\"/assets/home/curve-art.jpg\" alt=\"\" />\n              </div>\n            </div>\n          </div>\n          <div class=\"scopy\">\n            <div class=\"sblock on\" data-i=\"0\">\n              <div class=\"cno\">Chapter 01</div>\n              <h3>A decade of decks</h3>\n              <p>\n                Jeff has read more pitch decks than almost anyone alive.\n                Somewhere past the hundredth campaign they stopped being\n                interesting, because they stopped being predictive.\n              </p>\n              <p>\n                Two founders would arrive in the same week. Same market, same\n                revenue, same slide template, the same tidy hockey stick on\n                slide nine. One would be oversubscribed inside six weeks. The\n                other would spend nine months chasing meetings and quietly fold.\n                Nothing in either deck told you which was which, and everybody\n                in the room kept pretending it did.\n              </p>\n            </div>\n            <div class=\"sblock\" data-i=\"1\">\n              <div class=\"cno\">Chapter 02</div>\n              <h3>The one percent problem</h3>\n              <p>\n                Roughly one founder in a hundred raises the round they set out\n                to raise. That would be defensible if it were the best one in a\n                hundred.\n              </p>\n              <p>\n                It is not. It is the one who already knew somebody. The warm\n                introduction is the industry&rsquo;s stand-in for merit, and it\n                is a poor one: it measures who a founder went to school with,\n                who they worked for, which city they live in. Everyone in\n                venture knows this. Almost nobody has anything better to use, so\n                the proxy stays.\n              </p>\n            </div>\n            <div class=\"sblock\" data-i=\"2\">\n              <div class=\"cno\">Chapter 03</div>\n              <h3>So we went around it</h3>\n              <p>\n                The first founders we took on were B Corps and impact companies.\n                Certified, audited, real customers, real proof, and still told\n                their margins were too patient and their market too small.\n              </p>\n              <p>\n                So we stopped taking them to venture capital and took them to\n                the crowd instead. GOT BAG, pulling plastic out of the sea with\n                a network of Indonesian fishermen. Neighborhood Sun, putting\n                solar within reach of people who will never own a roof.\n                Regenesis, rebuilding soil. The crowd did not need convincing\n                that these were good businesses. In some cases it came back four\n                rounds running.\n              </p>\n            </div>\n            <div class=\"sblock\" data-i=\"3\">\n              <div class=\"cno\">Chapter 04</div>\n              <h3>It worked. It did not scale.</h3>\n              <p>\n                $100M+ raised. 850,000 investors reached. Campaigns that\n                finished in the top one percent of the platforms they launched\n                on.\n              </p>\n              <p>\n                And every single one of them was a small team doing the same\n                work again from nothing: the research, the positioning, the\n                list, the follow-up, the chase. Which meant the number of\n                founders we could help was capped by the number of hours we had.\n                For every founder we took on there were a hundred we had to turn\n                down, and most of them were turned down for our reasons, not\n                theirs.\n              </p>\n            </div>\n            <div class=\"sblock\" data-i=\"4\">\n              <div class=\"cno\">Chapter 05</div>\n              <h3>What we were actually doing</h3>\n              <p>\n                Strip out the campaign mechanics and the job was always the same\n                one. Prove the founder.\n              </p>\n              <p>\n                Not the market size. Not the design of the deck. What have they\n                actually built, who has paid them for it, who will put their\n                name behind them, and what did they do the last time something\n                broke. That is the assessment every serious investor already\n                runs. They just run it privately, slowly, and only for people\n                who reached them through someone they trust.\n              </p>\n            </div>\n            <div class=\"sblock\" data-i=\"5\">\n              <div class=\"cno\">Chapter 06</div>\n              <h3>So we turned it into a score</h3>\n              <p>\n                BFunded runs that assessment on any founder, in minutes, for\n                free. Pass the first tests and the network opens a little. Keep\n                proving it and it opens further, out to more than a million\n                investors.\n              </p>\n              <p>\n                Nothing is bought and no one is bumped up the queue. The\n                founders we spent a decade turning away for want of hours now\n                start on exactly the same page as the founder with the famous\n                cap table. That is the whole company, and it is the only part of\n                it we would not change.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"believers\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">Who We Built It For</div>\n        <h2 class=\"rise\" style=\"max-width: 17ch\">\n          Certified companies. Real customers. No venture round.\n        </h2>\n        <div class=\"cases\">\n          <div class=\"case rise\">\n            <div class=\"lgbox\">\n              <img class=\"lg\" src=\"/assets/home/p-gotbag.png\" alt=\"GOT BAG\" />\n            </div>\n            <div class=\"tag\">Certified B Corp</div>\n            <p>\n              Backpacks made from plastic pulled out of the sea by a network of\n              Indonesian fishermen. A B Impact score of 83.6, against a median\n              of 50.9.\n            </p>\n            <blockquote>\n              &ldquo;BFunded made fundraising easy for us so we can focus on\n              delivering value for GOT BAG.&rdquo;\n            </blockquote>\n            <cite>Matthias Paisdzior &middot; GOT BAG</cite>\n          </div>\n          <div class=\"case rise\">\n            <div class=\"lgbox\">\n              <img\n                class=\"lg\"\n                src=\"/assets/home/p-neighborhood.png\"\n                alt=\"Neighborhood Sun\"\n              />\n            </div>\n            <div class=\"tag\">Certified B Corp since 2017</div>\n            <p>\n              Community solar for the people who cannot put panels on their own\n              roof. A B Impact score of 105.8, and more than $4.5M taken off\n              subscribers&rsquo; power bills.\n            </p>\n            <blockquote>\n              &ldquo;William came in and ignited serious momentum with our\n              existing audience through precise messaging.&rdquo;\n            </blockquote>\n            <cite>Emily Tokarowski &middot; Neighborhood Sun</cite>\n          </div>\n          <div class=\"case rise\">\n            <div class=\"lgbox\">\n              <img\n                class=\"lg\"\n                src=\"/assets/home/p-regenesis.png\"\n                alt=\"Regenesis by Pangea\"\n              />\n            </div>\n            <div class=\"tag\">Four rounds with BFunded</div>\n            <p>\n              Regenerative agriculture, funded by a community of investors who\n              did not come once. They came back for the second round, then the\n              third, then the fourth.\n            </p>\n            <blockquote>\n              &ldquo;We have completed four rounds with BFunded, building a\n              global community of investors who believe in the long-term\n              vision.&rdquo;\n            </blockquote>\n            <cite>Marcos Boulacio &middot; Regenesis</cite>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"network\" class=\"band\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">The Network</div>\n        <h2 class=\"rise\" style=\"max-width: 18ch\">\n          Reach gets a founder seen. Expertise gets them funded.\n        </h2>\n        <p class=\"lede rise\">\n          A founder does not need a million investors. They need the few hundred\n          who understand what they are building and who have written cheques in\n          that sector before. The score decides how many of them a founder can\n          reach, and it is free to find out.\n        </p>\n        <div class=\"stats\">\n          <div class=\"stat rise\">\n            <b>1M+</b><span>Investors in the network</span>\n          </div>\n          <div class=\"stat rise\">\n            <b>50K</b><span>Industry-expert angels inside it</span>\n          </div>\n          <div class=\"stat rise\">\n            <b>1 in 12</b><span>Calls that convert for founders who pass</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"close\">\n      <div class=\"wrap\">\n        <h2 class=\"rise\">Work with BFunded.</h2>\n        <a class=\"go rise\" href=\"mailto:hello@bfunded.io\">Get in touch</a>\n        <div class=\"sub rise\">Free for founders &middot; No cost to apply</div>\n      </div>\n    </section>\n\n    <footer>\n      <div class=\"wrap\">\n        <p class=\"disc\">\n          BFunded is software and data only. We are not a broker-dealer, we\n          never custody funds, and we take no transaction-based compensation.\n          Nothing on this page is an offer to sell or a solicitation to buy\n          securities.\n        </p>\n        <div class=\"fin\">\n          <span>&copy; 2026 BFunded</span><span>hello@bfunded.io</span>\n        </div>\n      </div>\n    </footer>\n\n    <script>\n      (function () {\n        var els = document.querySelectorAll(\".rise\");\n        if (!(\"IntersectionObserver\" in window)) {\n          els.forEach(function (e) {\n            e.classList.add(\"on\");\n          });\n          return;\n        }\n        var io = new IntersectionObserver(\n          function (es) {\n            es.forEach(function (e) {\n              if (e.isIntersecting) {\n                e.target.classList.add(\"on\");\n                io.unobserve(e.target);\n              }\n            });\n          },\n          { threshold: 0.08, rootMargin: \"0px 0px -40px 0px\" },\n        );\n        els.forEach(function (e) {\n          io.observe(e);\n        });\n        setTimeout(function () {\n          document.querySelectorAll(\".rise:not(.on)\").forEach(function (e) {\n            if (e.getBoundingClientRect().top < innerHeight * 1.3)\n              e.classList.add(\"on\");\n          });\n        }, 900);\n      })();\n      (function () {\n        var blocks = [].slice.call(document.querySelectorAll(\".sblock\"));\n        var vis = [].slice.call(document.querySelectorAll(\".vis\"));\n        if (!blocks.length || !(\"IntersectionObserver\" in window)) return;\n        function show(i) {\n          vis.forEach(function (v) {\n            v.classList.toggle(\"on\", +v.dataset.i === i);\n          });\n          blocks.forEach(function (b) {\n            b.classList.toggle(\"on\", +b.dataset.i === i);\n          });\n        }\n        var io = new IntersectionObserver(\n          function (es) {\n            es.forEach(function (e) {\n              if (e.isIntersecting) show(+e.target.dataset.i);\n            });\n          },\n          { rootMargin: \"-45% 0px -45% 0px\", threshold: 0 },\n        );\n        blocks.forEach(function (b) {\n          io.observe(b);\n        });\n      })();\n    </script>\n  "