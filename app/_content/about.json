"<style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      :root {\n        --ink: #000;\n        --paper: #fff;\n        --muted: #8b8b8b;\n        --rule: rgba(255, 255, 255, 0.12);\n        --mint: #d6f2e4;\n        --accent: #3ec28f;\n      }\n      html {\n        scroll-behavior: smooth;\n        -webkit-text-size-adjust: 100%;\n      }\n      body {\n        background: var(--ink);\n        color: var(--paper);\n        font-family: \"DM Sans\", Inter, Arial, sans-serif;\n        font-weight: 400;\n        line-height: 1.5;\n        -webkit-font-smoothing: antialiased;\n      }\n      img,\n      video {\n        max-width: 100%;\n        display: block;\n      }\n      a {\n        color: inherit;\n        text-decoration: none;\n      }\n      .wrap {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: 0 32px;\n      }\n\n      /* nav */\n      .nav {\n        position: sticky;\n        top: 0;\n        z-index: 50;\n        background: rgba(0, 0, 0, 0.82);\n        backdrop-filter: blur(14px);\n      }\n      .nav-in {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: 20px 32px;\n        display: flex;\n        align-items: center;\n        gap: 20px;\n      }\n      .nav img {\n        height: 34px;\n      }\n      .nav-r {\n        margin-left: auto;\n        display: flex;\n        align-items: center;\n        gap: 32px;\n        font-size: 15px;\n        color: #cfcfcf;\n      }\n      .nav-r a.l:hover {\n        color: #fff;\n      }\n      .nav-cta {\n        border: 1px solid rgba(255, 255, 255, 0.35);\n        border-radius: 100px;\n        padding: 11px 24px;\n        font-size: 15px;\n        color: #fff;\n      }\n      .nav-cta:hover {\n        background: #fff;\n        color: #000;\n      }\n      @media (max-width: 860px) {\n        .nav-r a.l {\n          display: none;\n        }\n        .nav-in {\n          padding: 16px 22px;\n        }\n      }\n\n      /* hero */\n      .hero {\n        position: relative;\n        min-height: 78vh;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        text-align: center;\n        overflow: hidden;\n      }\n      .hero > img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n      }\n      .hero .veil {\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(\n          180deg,\n          rgba(0, 0, 0, 0.6),\n          rgba(0, 0, 0, 0.45) 45%,\n          rgba(0, 0, 0, 0.85)\n        );\n      }\n      .hero .in {\n        position: relative;\n        padding: 120px 32px;\n      }\n      h1 {\n        font-weight: 400;\n        letter-spacing: -0.03em;\n        line-height: 1.02;\n        font-size: clamp(44px, 7.2vw, 104px);\n      }\n      .hero p {\n        margin: 28px auto 0;\n        max-width: 620px;\n        font-size: clamp(17px, 1.5vw, 21px);\n        color: #c9c9c9;\n        font-weight: 400;\n      }\n\n      /* sections */\n      section {\n        padding: clamp(80px, 10vw, 150px) 0;\n        scroll-margin-top: 90px;\n      }\n      .eyebrow {\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n        color: var(--accent);\n        font-weight: 600;\n        margin-bottom: 22px;\n      }\n      h2 {\n        font-weight: 400;\n        letter-spacing: -0.025em;\n        line-height: 1.06;\n        font-size: clamp(34px, 5vw, 72px);\n      }\n      .lede {\n        margin-top: 26px;\n        max-width: 680px;\n        font-size: clamp(17px, 1.5vw, 21px);\n        color: #b4b4b4;\n        line-height: 1.6;\n      }\n\n      /* three-up, no boxes */\n      .trio {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(28px, 4vw, 64px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .trio .n {\n        font-size: 15px;\n        color: var(--accent);\n        font-family: Inter, sans-serif;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n      }\n      .trio h3 {\n        margin-top: 20px;\n        font-size: clamp(21px, 2vw, 28px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n        line-height: 1.25;\n      }\n      .trio p {\n        margin-top: 14px;\n        font-size: 16px;\n        color: #9a9a9a;\n        line-height: 1.65;\n      }\n      @media (max-width: 800px) {\n        .trio {\n          grid-template-columns: 1fr;\n          gap: 40px;\n        }\n      }\n\n      /* numbered steps as type, not boxes */\n      .steps {\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid var(--rule);\n      }\n      .step {\n        display: grid;\n        grid-template-columns: 70px 1fr 200px;\n        gap: 28px;\n        align-items: baseline;\n        padding: clamp(26px, 3vw, 40px) 0;\n        border-bottom: 1px solid var(--rule);\n      }\n      .step .i {\n        font-family: Inter, sans-serif;\n        font-size: 14px;\n        color: var(--muted);\n        letter-spacing: 0.08em;\n      }\n      .step h3 {\n        font-size: clamp(20px, 2.2vw, 32px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      }\n      .step .r {\n        text-align: right;\n        font-size: 15px;\n        color: var(--accent);\n        font-family: Inter, sans-serif;\n        letter-spacing: 0.02em;\n      }\n      @media (max-width: 800px) {\n        .step {\n          grid-template-columns: 44px 1fr;\n          gap: 16px;\n        }\n        .step .r {\n          grid-column: 2;\n          text-align: left;\n          margin-top: 8px;\n        }\n      }\n\n      /* stat line */\n      .stats {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(24px, 4vw, 56px);\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid var(--rule);\n        padding-top: clamp(36px, 4vw, 56px);\n      }\n      .stat b {\n        display: block;\n        font-size: clamp(40px, 5.4vw, 76px);\n        font-weight: 300;\n        letter-spacing: -0.035em;\n        line-height: 1;\n      }\n      .stat span {\n        display: block;\n        margin-top: 14px;\n        font-size: 15px;\n        color: #9a9a9a;\n        line-height: 1.5;\n      }\n      @media (max-width: 800px) {\n        .stats {\n          grid-template-columns: 1fr;\n          gap: 32px;\n        }\n      }\n\n      /* team */\n      .team {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(24px, 3vw, 44px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .person img {\n        width: 100%;\n        aspect-ratio: 0.82;\n        object-fit: cover;\n        border-radius: 4px;\n        filter: grayscale(100%);\n        transition: filter 0.5s ease;\n      }\n      .person:hover img {\n        filter: grayscale(0);\n      }\n      .person h3 {\n        margin-top: 24px;\n        font-size: clamp(20px, 1.8vw, 26px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      }\n      .person .role {\n        margin-top: 6px;\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--accent);\n      }\n      .person p {\n        margin-top: 16px;\n        font-size: 15px;\n        color: #9a9a9a;\n        line-height: 1.65;\n      }\n      @media (max-width: 800px) {\n        .team {\n          grid-template-columns: 1fr;\n          gap: 48px;\n          max-width: 420px;\n        }\n      }\n\n      /* mint band */\n      .band {\n        background: var(--mint);\n        color: #0b0b0b;\n      }\n      .band .eyebrow {\n        color: #1d7a57;\n      }\n      .band .lede {\n        color: #3b4a44;\n      }\n\n      /* close */\n      .close {\n        text-align: center;\n      }\n      .close h2 {\n        max-width: 14ch;\n        margin: 0 auto;\n      }\n      .close .go {\n        display: inline-block;\n        margin-top: 44px;\n        border: 1px solid rgba(255, 255, 255, 0.4);\n        border-radius: 100px;\n        padding: 19px 46px;\n        font-size: 17px;\n        letter-spacing: 0.01em;\n      }\n      .close .go:hover {\n        background: #fff;\n        color: #000;\n      }\n      .close .sub {\n        margin-top: 22px;\n        font-size: 15px;\n        color: var(--muted);\n      }\n\n      footer {\n        border-top: 1px solid var(--rule);\n        padding: 56px 0 72px;\n        font-size: 14px;\n        color: var(--muted);\n      }\n      footer .fin {\n        display: flex;\n        justify-content: space-between;\n        gap: 20px;\n        flex-wrap: wrap;\n      }\n      footer .disc {\n        max-width: 720px;\n        margin-bottom: 26px;\n        line-height: 1.7;\n      }\n\n      .rise {\n        opacity: 0;\n        transform: translateY(22px);\n        transition:\n          opacity 0.8s cubic-bezier(0.22, 0.75, 0.2, 1),\n          transform 0.8s cubic-bezier(0.22, 0.75, 0.2, 1);\n      }\n      .rise.on {\n        opacity: 1;\n        transform: none;\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .rise {\n          opacity: 1;\n          transform: none;\n          transition: none;\n        }\n      }\n    </style>\n\n    <nav class=\"nav\">\n      <div class=\"nav-in\">\n        <a href=\"https://www.bfunded.io/\"\n          ><img src=\"/assets/home/logo-white.svg\" alt=\"BFunded\"\n        /></a>\n        <div class=\"nav-r\">\n          <a href=\"#what\" class=\"l\">What We Do</a>\n          <a href=\"#how\" class=\"l\">How It Works</a>\n          <a href=\"#team\" class=\"l\">Team</a>\n          <a href=\"mailto:hello@bfunded.io\" class=\"nav-cta\">Get In Touch</a>\n        </div>\n      </div>\n    </nav>\n\n    <header class=\"hero\">\n      <img src=\"/assets/home/band-forest.jpg\" alt=\"\" />\n      <div class=\"veil\"></div>\n      <div class=\"in\">\n        <h1 class=\"rise\">We Score Founders.<br />Not Pitch Decks.</h1>\n        <p class=\"rise\">\n          A founder gets scored in minutes, free. Full due diligence is earned\n          after that &mdash; they pass tests, level up, and reach investors who\n          understand their sector as the evidence builds.\n        </p>\n      </div>\n    </header>\n\n    <section id=\"what\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">What We Do</div>\n        <h2 class=\"rise\">Three things, and nothing else.</h2>\n        <div class=\"trio\">\n          <div class=\"rise\">\n            <div class=\"n\">01</div>\n            <h3>A score in minutes, free</h3>\n            <p>\n              A founder uploads a deck and a website. Our system reads it and\n              returns a score straight away, at no cost. That is where diligence\n              starts, not where it ends.\n            </p>\n          </div>\n          <div class=\"rise\">\n            <div class=\"n\">02</div>\n            <h3>We assess the founder</h3>\n            <p>\n              Fundability is a quality of the person, not the pitch. We look at\n              what a founder has actually done, not how well they present it.\n            </p>\n          </div>\n          <div class=\"rise\">\n            <div class=\"n\">03</div>\n            <h3>We introduce them properly</h3>\n            <p>\n              Founders who pass reach investors with real experience in their\n              sector, not a mailing list. Relevance is the whole point.\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"how\" class=\"band\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">How It Works</div>\n        <h2 class=\"rise\" style=\"max-width: 16ch\">\n          Access is earned, one step at a time.\n        </h2>\n        <p class=\"lede rise\">\n          Nothing is bought. Each stage a founder completes opens a wider circle\n          of investors, and the circle only widens when the evidence does.\n        </p>\n        <div class=\"steps\" style=\"border-color: rgba(0, 0, 0, 0.14)\">\n          <div class=\"step rise\" style=\"border-color: rgba(0, 0, 0, 0.14)\">\n            <div class=\"i\" style=\"color: #5f7269\">01</div>\n            <h3>Deck and website uploaded</h3>\n            <div class=\"r\" style=\"color: #1d7a57\">100 investors</div>\n          </div>\n          <div class=\"step rise\" style=\"border-color: rgba(0, 0, 0, 0.14)\">\n            <div class=\"i\" style=\"color: #5f7269\">02</div>\n            <h3>First diligence tests passed</h3>\n            <div class=\"r\" style=\"color: #1d7a57\">1,000 investors</div>\n          </div>\n          <div class=\"step rise\" style=\"border-color: rgba(0, 0, 0, 0.14)\">\n            <div class=\"i\" style=\"color: #5f7269\">03</div>\n            <h3>Five calls scheduled</h3>\n            <div class=\"r\" style=\"color: #1d7a57\">5,000 investors</div>\n          </div>\n          <div class=\"step rise\" style=\"border-color: rgba(0, 0, 0, 0.14)\">\n            <div class=\"i\" style=\"color: #5f7269\">04</div>\n            <h3>First investor closed</h3>\n            <div class=\"r\" style=\"color: #1d7a57\">20,000 investors</div>\n          </div>\n          <div class=\"step rise\" style=\"border-color: rgba(0, 0, 0, 0.14)\">\n            <div class=\"i\" style=\"color: #5f7269\">05</div>\n            <h3>Three investors closed</h3>\n            <div class=\"r\" style=\"color: #1d7a57\">Full network</div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section>\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">The Network</div>\n        <h2 class=\"rise\" style=\"max-width: 18ch\">\n          Reach gets a founder seen. Expertise gets them funded.\n        </h2>\n        <p class=\"lede rise\">\n          A founder does not need a million investors. They need the few hundred\n          who understand what they are building, and who have written cheques in\n          that sector before.\n        </p>\n        <div class=\"stats\">\n          <div class=\"stat rise\">\n            <b>1M+</b><span>Investors in the network</span>\n          </div>\n          <div class=\"stat rise\">\n            <b>50K</b><span>Industry-expert angels inside it</span>\n          </div>\n          <div class=\"stat rise\">\n            <b>1 in 12</b><span>Calls that convert for founders who pass</span>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"team\">\n      <div class=\"wrap\">\n        <div class=\"eyebrow rise\">Who We Are</div>\n        <h2 class=\"rise\">Built by people who have raised.</h2>\n        <div class=\"team\">\n          <div class=\"person rise\">\n            <img src=\"/assets/home/jeff-io.png\" alt=\"Jeff Wenzel\" />\n            <h3>Jeff Wenzel</h3>\n            <div class=\"role\">Chief Executive Officer</div>\n            <p>\n              170+ equity crowdfunding campaigns over a decade. $100M+ raised\n              for early-stage founders. 300+ Kickstarter launches and 850K+\n              investors reached.\n            </p>\n          </div>\n          <div class=\"person rise\">\n            <img src=\"/assets/home/will-io.png\" alt=\"William DiRicco\" />\n            <h3>William DiRicco</h3>\n            <div class=\"role\">Chief Operating Officer</div>\n            <p>\n              $11M raised for early-stage companies and 10\u00d7 returned to early\n              investors through secondaries. $15M in brand deals with Gucci,\n              Nike and Ray-Ban.\n            </p>\n          </div>\n          <div class=\"person rise\">\n            <img src=\"/assets/home/anthony-crop.jpg\" alt=\"Anthony Cargill\" />\n            <h3>Anthony Cargill</h3>\n            <div class=\"role\">Chief Marketing Officer</div>\n            <p>\n              12+ years scaling startups and agencies. Go-to-market for a\n              unicorn AI security company, and cross-border commerce across the\n              US and Asia.\n            </p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"close\">\n      <div class=\"wrap\">\n        <h2 class=\"rise\">Work with BFunded.</h2>\n        <a class=\"go rise\" href=\"mailto:hello@bfunded.io\">Get in touch</a>\n        <div class=\"sub rise\">Free for founders &middot; No cost to apply</div>\n      </div>\n    </section>\n\n    <footer>\n      <div class=\"wrap\">\n        <p class=\"disc\">\n          BFunded is software and data only. We are not a broker-dealer, we\n          never custody funds, and we take no transaction-based compensation.\n          Nothing on this page is an offer to sell or a solicitation to buy\n          securities.\n        </p>\n        <div class=\"fin\">\n          <span>&copy; 2026 BFunded</span><span>hello@bfunded.io</span>\n        </div>\n      </div>\n    </footer>\n\n    <script>\n      (function () {\n        var els = document.querySelectorAll(\".rise\");\n        if (!(\"IntersectionObserver\" in window)) {\n          els.forEach(function (e) {\n            e.classList.add(\"on\");\n          });\n          return;\n        }\n        var io = new IntersectionObserver(\n          function (es) {\n            es.forEach(function (e) {\n              if (e.isIntersecting) {\n                e.target.classList.add(\"on\");\n                io.unobserve(e.target);\n              }\n            });\n          },\n          { threshold: 0.08, rootMargin: \"0px 0px -40px 0px\" },\n        );\n        els.forEach(function (e) {\n          io.observe(e);\n        });\n        setTimeout(function () {\n          document.querySelectorAll(\".rise:not(.on)\").forEach(function (e) {\n            if (e.getBoundingClientRect().top < innerHeight * 1.3)\n              e.classList.add(\"on\");\n          });\n        }, 900);\n      })();\n    </script>\n  "