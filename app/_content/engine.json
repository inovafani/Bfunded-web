"<style>\n      * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n      }\n      :root {\n        --ink: #000;\n        --paper: #fff;\n        --muted: #8b8b8b;\n        --rule: rgba(255, 255, 255, 0.12);\n        --mint: #d6f2e4;\n        --accent: #3ec28f;\n      }\n      html {\n        scroll-behavior: smooth;\n        -webkit-text-size-adjust: 100%;\n      }\n      body {\n        background: var(--ink);\n        color: var(--paper);\n        font-family: \"DM Sans\", Inter, Arial, sans-serif;\n        font-weight: 400;\n        line-height: 1.5;\n        -webkit-font-smoothing: antialiased;\n      }\n      img,\n      video {\n        max-width: 100%;\n        display: block;\n      }\n      a {\n        color: inherit;\n        text-decoration: none;\n      }\n      .wrap {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: 0 32px;\n      }\n\n      /* nav */\n      .nav {\n        position: sticky;\n        top: 0;\n        z-index: 50;\n        background: rgba(0, 0, 0, 0.82);\n        backdrop-filter: blur(14px);\n      }\n      .nav-in {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: 20px 32px;\n        display: flex;\n        align-items: center;\n        gap: 20px;\n      }\n      .nav img {\n        height: 34px;\n      }\n      .nav-r {\n        margin-left: auto;\n        display: flex;\n        align-items: center;\n        gap: 32px;\n        font-size: 15px;\n        color: #cfcfcf;\n      }\n      .nav-r a.l:hover {\n        color: #fff;\n      }\n      .nav-cta {\n        border: 1px solid rgba(255, 255, 255, 0.35);\n        border-radius: 100px;\n        padding: 11px 24px;\n        font-size: 15px;\n        color: #fff;\n      }\n      .nav-cta:hover {\n        background: #fff;\n        color: #000;\n      }\n      @media (max-width: 860px) {\n        .nav-r a.l {\n          display: none;\n        }\n        .nav-in {\n          padding: 16px 22px;\n        }\n      }\n\n      /* hero */\n      .hero {\n        position: relative;\n        min-height: 78vh;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        text-align: center;\n        overflow: hidden;\n      }\n      .hero > img {\n        position: absolute;\n        inset: 0;\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n      }\n      .hero .veil {\n        position: absolute;\n        inset: 0;\n        background: linear-gradient(\n          180deg,\n          rgba(0, 0, 0, 0.6),\n          rgba(0, 0, 0, 0.45) 45%,\n          rgba(0, 0, 0, 0.85)\n        );\n      }\n      .hero .in {\n        position: relative;\n        padding: 120px 32px;\n      }\n      h1 {\n        font-weight: 400;\n        letter-spacing: -0.03em;\n        line-height: 1.02;\n        font-size: clamp(44px, 7.2vw, 104px);\n      }\n      .hero p {\n        margin: 28px auto 0;\n        max-width: 620px;\n        font-size: clamp(17px, 1.5vw, 21px);\n        color: #c9c9c9;\n        font-weight: 400;\n      }\n\n      /* sections */\n      section {\n        padding: clamp(80px, 10vw, 150px) 0;\n        scroll-margin-top: 90px;\n      }\n      .eyebrow {\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.18em;\n        text-transform: uppercase;\n        color: var(--accent);\n        font-weight: 600;\n        margin-bottom: 22px;\n      }\n      h2 {\n        font-weight: 400;\n        letter-spacing: -0.025em;\n        line-height: 1.06;\n        font-size: clamp(34px, 5vw, 72px);\n      }\n      .lede {\n        margin-top: 26px;\n        max-width: 680px;\n        font-size: clamp(17px, 1.5vw, 21px);\n        color: #b4b4b4;\n        line-height: 1.6;\n      }\n\n      /* three-up, no boxes */\n      .trio {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(28px, 4vw, 64px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .trio .n {\n        font-size: 15px;\n        color: var(--accent);\n        font-family: Inter, sans-serif;\n        font-weight: 600;\n        letter-spacing: 0.1em;\n      }\n      .trio h3 {\n        margin-top: 20px;\n        font-size: clamp(21px, 2vw, 28px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n        line-height: 1.25;\n      }\n      .trio p {\n        margin-top: 14px;\n        font-size: 16px;\n        color: #9a9a9a;\n        line-height: 1.65;\n      }\n      @media (max-width: 800px) {\n        .trio {\n          grid-template-columns: 1fr;\n          gap: 40px;\n        }\n      }\n\n      /* numbered steps as type, not boxes */\n      .steps {\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid var(--rule);\n      }\n      .step {\n        display: grid;\n        grid-template-columns: 70px 1fr 200px;\n        gap: 28px;\n        align-items: baseline;\n        padding: clamp(26px, 3vw, 40px) 0;\n        border-bottom: 1px solid var(--rule);\n      }\n      .step .i {\n        font-family: Inter, sans-serif;\n        font-size: 14px;\n        color: var(--muted);\n        letter-spacing: 0.08em;\n      }\n      .step h3 {\n        font-size: clamp(20px, 2.2vw, 32px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      }\n      .step .r {\n        text-align: right;\n        font-size: 15px;\n        color: var(--accent);\n        font-family: Inter, sans-serif;\n        letter-spacing: 0.02em;\n      }\n      @media (max-width: 800px) {\n        .step {\n          grid-template-columns: 44px 1fr;\n          gap: 16px;\n        }\n        .step .r {\n          grid-column: 2;\n          text-align: left;\n          margin-top: 8px;\n        }\n      }\n\n      /* stat line */\n      .stats {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(24px, 4vw, 56px);\n        margin-top: clamp(48px, 6vw, 80px);\n        border-top: 1px solid var(--rule);\n        padding-top: clamp(36px, 4vw, 56px);\n      }\n      .stat b {\n        display: block;\n        font-size: clamp(40px, 5.4vw, 76px);\n        font-weight: 300;\n        letter-spacing: -0.035em;\n        line-height: 1;\n      }\n      .stat span {\n        display: block;\n        margin-top: 14px;\n        font-size: 15px;\n        color: #9a9a9a;\n        line-height: 1.5;\n      }\n      @media (max-width: 800px) {\n        .stats {\n          grid-template-columns: 1fr;\n          gap: 32px;\n        }\n      }\n\n      /* team */\n      .team {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: clamp(24px, 3vw, 44px);\n        margin-top: clamp(52px, 6vw, 88px);\n      }\n      .person img {\n        width: 100%;\n        aspect-ratio: 0.82;\n        object-fit: cover;\n        border-radius: 4px;\n        filter: grayscale(100%);\n        transition: filter 0.5s ease;\n      }\n      .person:hover img {\n        filter: grayscale(0);\n      }\n      .person h3 {\n        margin-top: 24px;\n        font-size: clamp(20px, 1.8vw, 26px);\n        font-weight: 400;\n        letter-spacing: -0.015em;\n      }\n      .person .role {\n        margin-top: 6px;\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        letter-spacing: 0.14em;\n        text-transform: uppercase;\n        color: var(--accent);\n      }\n      .person p {\n        margin-top: 16px;\n        font-size: 15px;\n        color: #9a9a9a;\n        line-height: 1.65;\n      }\n      @media (max-width: 800px) {\n        .team {\n          grid-template-columns: 1fr;\n          gap: 48px;\n          max-width: 420px;\n        }\n      }\n\n      /* mint band */\n      .band {\n        background: var(--mint);\n        color: #0b0b0b;\n      }\n      .band .eyebrow {\n        color: #1d7a57;\n      }\n      .band .lede {\n        color: #3b4a44;\n      }\n\n      /* close */\n      .close {\n        text-align: center;\n      }\n      .close h2 {\n        max-width: 14ch;\n        margin: 0 auto;\n      }\n      .close .go {\n        display: inline-block;\n        margin-top: 44px;\n        border: 1px solid rgba(255, 255, 255, 0.4);\n        border-radius: 100px;\n        padding: 19px 46px;\n        font-size: 17px;\n        letter-spacing: 0.01em;\n      }\n      .close .go:hover {\n        background: #fff;\n        color: #000;\n      }\n      .close .sub {\n        margin-top: 22px;\n        font-size: 15px;\n        color: var(--muted);\n      }\n\n      footer {\n        border-top: 1px solid var(--rule);\n        padding: 56px 0 72px;\n        font-size: 14px;\n        color: var(--muted);\n      }\n      footer .fin {\n        display: flex;\n        justify-content: space-between;\n        gap: 20px;\n        flex-wrap: wrap;\n      }\n      footer .disc {\n        max-width: 720px;\n        margin-bottom: 26px;\n        line-height: 1.7;\n      }\n\n      .rise {\n        opacity: 0;\n        transform: translateY(22px);\n        transition:\n          opacity 0.8s cubic-bezier(0.22, 0.75, 0.2, 1),\n          transform 0.8s cubic-bezier(0.22, 0.75, 0.2, 1);\n      }\n      .rise.on {\n        opacity: 1;\n        transform: none;\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .rise {\n          opacity: 1;\n          transform: none;\n          transition: none;\n        }\n      }\n\n      /* product shots, rendered in css */\n      .appwrap {\n        margin-top: clamp(48px, 6vw, 80px);\n      }\n      .app {\n        background: #fbfbf9;\n        border-radius: 14px;\n        overflow: hidden;\n        color: #16211d;\n        box-shadow: 0 50px 90px -46px rgba(0, 0, 0, 0.85);\n        display: grid;\n        grid-template-columns: 236px 1fr;\n      }\n      .app .side {\n        background: #f2f3f0;\n        border-right: 1px solid #e2e5e0;\n        padding: 18px 14px;\n        display: flex;\n        flex-direction: column;\n        gap: 14px;\n      }\n      .app .brand {\n        display: flex;\n        align-items: center;\n        gap: 9px;\n        font-weight: 600;\n        font-size: 14px;\n      }\n      .app .brand i {\n        width: 22px;\n        height: 22px;\n        border-radius: 50%;\n        border: 1.5px solid #16211d;\n        display: block;\n      }\n      .app .sub {\n        font-size: 10.5px;\n        color: #7a857f;\n        margin-top: -9px;\n      }\n      .app .srch {\n        background: #fff;\n        border: 1px solid #e2e5e0;\n        border-radius: 8px;\n        padding: 8px 10px;\n        font-size: 12px;\n        color: #8b948f;\n        display: flex;\n        justify-content: space-between;\n      }\n      .app .navi {\n        display: flex;\n        flex-direction: column;\n        gap: 2px;\n      }\n      .app .navi a {\n        padding: 9px 10px;\n        border-radius: 8px;\n        font-size: 13px;\n        color: #4c5854;\n      }\n      .app .navi a.on {\n        background: #dff0e6;\n        color: #0f3d2c;\n        font-weight: 600;\n      }\n      .app .money {\n        background: #fff;\n        border: 1px solid #e2e5e0;\n        border-radius: 10px;\n        padding: 13px;\n      }\n      .app .money u {\n        display: block;\n        text-decoration: none;\n        font-family: Inter, sans-serif;\n        font-size: 9px;\n        letter-spacing: 0.12em;\n        color: #8b948f;\n        text-transform: uppercase;\n      }\n      .app .money b {\n        display: block;\n        font-size: 26px;\n        font-weight: 500;\n        letter-spacing: -0.02em;\n        margin-top: 6px;\n        min-height: 31px;\n      }\n      .app .money .pb {\n        height: 4px;\n        border-radius: 3px;\n        background: #e4e7e3;\n        margin: 10px 0 7px;\n        overflow: hidden;\n      }\n      .app .money .pb i {\n        display: block;\n        height: 100%;\n        width: 4%;\n        background: var(--accent);\n      }\n      .app .money span {\n        font-size: 10.5px;\n        color: #7a857f;\n      }\n      .app .main {\n        padding: 22px 24px 26px;\n        min-width: 0;\n      }\n      .app .top {\n        display: flex;\n        align-items: baseline;\n        gap: 10px;\n      }\n      .app .top b {\n        font-size: 19px;\n        font-weight: 600;\n      }\n      .app .top span {\n        font-size: 13px;\n        color: #7a857f;\n      }\n      .app .top em {\n        margin-left: auto;\n        font-style: normal;\n        color: var(--accent);\n        font-weight: 600;\n        font-size: 13px;\n      }\n      .app .tbar {\n        height: 4px;\n        border-radius: 3px;\n        background: #e4e7e3;\n        margin: 11px 0 6px;\n        overflow: hidden;\n      }\n      .app .tbar i {\n        display: block;\n        height: 100%;\n        width: 4%;\n        background: var(--accent);\n      }\n      .app .tnote {\n        font-size: 11px;\n        color: #8b948f;\n        min-height: 14px;\n      }\n      .app .next {\n        margin-top: 18px;\n        background: #fff;\n        border: 1px solid #e6e8e4;\n        border-left: 3px solid #d98324;\n        border-radius: 10px;\n        padding: 15px 16px;\n      }\n      .app .next u {\n        display: block;\n        text-decoration: none;\n        font-family: Inter, sans-serif;\n        font-size: 9px;\n        letter-spacing: 0.11em;\n        color: #b0762c;\n        text-transform: uppercase;\n      }\n      .app .next b {\n        display: block;\n        font-size: 16px;\n        font-weight: 600;\n        margin-top: 8px;\n      }\n      .app .next p {\n        font-size: 12px;\n        color: #6d7873;\n        margin-top: 6px;\n        line-height: 1.5;\n      }\n      .app .next .btn {\n        display: inline-block;\n        margin-top: 12px;\n        background: #d98324;\n        color: #fff;\n        border-radius: 8px;\n        padding: 8px 14px;\n        font-size: 12px;\n        font-weight: 600;\n      }\n      .app .track {\n        margin-top: 20px;\n        display: flex;\n        flex-direction: column;\n        gap: 0;\n      }\n      .app .trow {\n        display: flex;\n        align-items: center;\n        gap: 11px;\n        padding: 8px 0;\n        font-size: 13px;\n        color: #6d7873;\n      }\n      .app .trow i {\n        width: 19px;\n        height: 19px;\n        border-radius: 50%;\n        background: #1f7a55;\n        color: #fff;\n        font-style: normal;\n        font-size: 10px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        flex: none;\n      }\n      .app .trow.now {\n        color: #16211d;\n        font-weight: 600;\n      }\n      .app .trow.now i {\n        background: #fff;\n        border: 1.5px solid #1f7a55;\n        color: #1f7a55;\n      }\n      @media (max-width: 820px) {\n        .app {\n          grid-template-columns: 1fr;\n        }\n        .app .side {\n          display: none;\n        }\n      }\n\n      .duo2 {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: clamp(20px, 2.6vw, 32px);\n        margin-top: clamp(20px, 2.6vw, 32px);\n      }\n      .mini {\n        background: #fbfbf9;\n        border-radius: 14px;\n        padding: 20px;\n        color: #16211d;\n        box-shadow: 0 40px 80px -46px rgba(0, 0, 0, 0.8);\n      }\n      .mini u {\n        display: block;\n        text-decoration: none;\n        font-family: Inter, sans-serif;\n        font-size: 9px;\n        letter-spacing: 0.12em;\n        color: #8b948f;\n        text-transform: uppercase;\n        margin-bottom: 12px;\n      }\n      .mini h4 {\n        font-size: 15px;\n        font-weight: 600;\n        margin-bottom: 4px;\n      }\n      .mini p {\n        font-size: 11.5px;\n        color: #6d7873;\n        line-height: 1.5;\n      }\n      .chips {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 6px;\n        margin-top: 12px;\n      }\n      .chip {\n        border: 1px solid #dfe3de;\n        border-radius: 100px;\n        padding: 5px 11px;\n        font-size: 11px;\n        color: #5b6560;\n      }\n      .chip.on {\n        background: #16211d;\n        color: #fff;\n        border-color: #16211d;\n      }\n      .findbtn {\n        display: inline-block;\n        margin-top: 14px;\n        background: #16211d;\n        color: #fff;\n        border-radius: 8px;\n        padding: 8px 14px;\n        font-size: 12px;\n        font-weight: 600;\n      }\n      .cmsg {\n        max-width: 88%;\n        padding: 8px 11px;\n        border-radius: 12px;\n        font-size: 11.5px;\n        line-height: 1.45;\n        margin-bottom: 7px;\n      }\n      .cmsg.them {\n        background: #eef0ec;\n        color: #3f4a45;\n        border-bottom-left-radius: 4px;\n      }\n      .cmsg.us {\n        background: #1f7a55;\n        color: #fff;\n        margin-left: auto;\n        border-bottom-right-radius: 4px;\n      }\n      @media (max-width: 820px) {\n        .duo2 {\n          grid-template-columns: 1fr;\n        }\n      }\n\n      /* the mockup runs: progress climbs, notifications land */\n      .toastwrap {\n        position: absolute;\n        top: 12px;\n        right: 11px;\n        width: min(232px, 35%);\n        height: 86px;\n        pointer-events: none;\n        z-index: 6;\n      }\n      .toast {\n        position: absolute;\n        left: 0;\n        right: 0;\n        background: rgba(15, 18, 16, 0.94);\n        border: 1px solid rgba(255, 255, 255, 0.16);\n        border-radius: 12px;\n        padding: 10px 13px 10px 39px;\n        box-shadow: 0 26px 50px -22px rgba(0, 0, 0, 0.9);\n        color: #fff;\n        -webkit-backdrop-filter: blur(10px);\n        backdrop-filter: blur(10px);\n        opacity: 0;\n        transform: translateX(20px) scale(0.97);\n        animation: toastIn 24s cubic-bezier(0.22, 0.75, 0.2, 1) infinite;\n      }\n      .toast i {\n        position: absolute;\n        left: 12px;\n        top: 11px;\n        width: 19px;\n        height: 19px;\n        border-radius: 50%;\n        background: var(--accent);\n        color: #07130d;\n        font-style: normal;\n        font-size: 9.5px;\n        font-weight: 700;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n      }\n      .toast b {\n        display: block;\n        font-size: 12px;\n        font-weight: 600;\n        line-height: 1.25;\n      }\n      .toast span {\n        display: block;\n        font-size: 10.5px;\n        color: #a4afa8;\n        margin-top: 3px;\n        line-height: 1.35;\n      }\n      .toast {\n        top: 0;\n      }\n      .toast.t1 {\n        animation-delay: 0.4s;\n      }\n      .toast.t2 {\n        animation-delay: 4.4s;\n      }\n      .toast.t3 {\n        animation-delay: 8.4s;\n      }\n      .toast.t4 {\n        animation-delay: 12.4s;\n      }\n      .toast.t5 {\n        animation-delay: 16.4s;\n      }\n      .toast.t6 {\n        animation-delay: 20.4s;\n      }\n      @keyframes toastIn {\n        0% {\n          opacity: 0;\n          transform: translateX(20px) scale(0.97);\n        }\n        1.7% {\n          opacity: 1;\n          transform: translateX(0) scale(1);\n        }\n        15.5% {\n          opacity: 1;\n          transform: translateX(0) scale(1);\n        }\n        17.5% {\n          opacity: 0;\n          transform: translateX(0) scale(0.99);\n        }\n        100% {\n          opacity: 0;\n        }\n      }\n      /* free-reach counter climbs as the score climbs */\n      .dbar i {\n        animation: fill 24s cubic-bezier(0.5, 0, 0.2, 1) infinite;\n      }\n      @keyframes fill {\n        0%,\n        40% {\n          width: 12%;\n        }\n        44% {\n          width: 38%;\n        }\n        73.5% {\n          width: 38%;\n        }\n        77.5% {\n          width: 100%;\n        }\n        100% {\n          width: 100%;\n        }\n      }\n      .tick {\n        position: relative;\n        display: inline-block;\n        min-width: 3.3ch;\n        text-align: right;\n      }\n      .tick span {\n        position: absolute;\n        right: 0;\n        top: 0;\n        white-space: nowrap;\n      }\n      .tick span:first-child {\n        position: relative;\n      }\n      .tick span:nth-child(1) {\n        animation: v1 24s steps(1) infinite;\n      }\n      .tick span:nth-child(2) {\n        animation: v2 24s steps(1) infinite;\n      }\n      .tick span:nth-child(3) {\n        animation: v3 24s steps(1) infinite;\n      }\n      @keyframes v1 {\n        0% {\n          opacity: 1;\n        }\n        40% {\n          opacity: 1;\n        }\n        40.1% {\n          opacity: 0;\n        }\n        100% {\n          opacity: 0;\n        }\n      }\n      @keyframes v2 {\n        0% {\n          opacity: 0;\n        }\n        40% {\n          opacity: 0;\n        }\n        40.1% {\n          opacity: 1;\n        }\n        73.5% {\n          opacity: 1;\n        }\n        73.6% {\n          opacity: 0;\n        }\n        100% {\n          opacity: 0;\n        }\n      }\n      @keyframes v3 {\n        0% {\n          opacity: 0;\n        }\n        73.5% {\n          opacity: 0;\n        }\n        73.6% {\n          opacity: 1;\n        }\n        100% {\n          opacity: 1;\n        }\n      }\n      @media (max-width: 820px) {\n        .toastwrap {\n          width: auto;\n          top: 8px;\n          left: 8px;\n          right: 8px;\n          height: 62px;\n        }\n        .toast {\n          padding: 9px 12px 9px 36px;\n          top: 0;\n          bottom: auto;\n        }\n        .toast b {\n          font-size: 11.5px;\n        }\n        .toast span {\n          font-size: 10px;\n        }\n      }\n      @media (prefers-reduced-motion: reduce) {\n        .toast {\n          animation: none;\n          opacity: 1;\n          transform: none;\n        }\n        .toast.t3,\n        .toast.t4,\n        .toast.t5,\n        .toast.t6 {\n          display: none;\n        }\n        .dbar i {\n          animation: none;\n          width: 38%;\n        }\n        .tick span {\n          animation: none;\n        }\n        .tick span:not(:first-child) {\n          display: none;\n        }\n      }\n\n      /* scroll-driven product sequence */\n      .scroller {\n        display: grid;\n        grid-template-columns: minmax(0, 30%) minmax(0, 70%);\n        gap: clamp(30px, 5vw, 80px);\n        margin-top: clamp(40px, 5vw, 64px);\n        align-items: start;\n      }\n      .svis {\n        position: sticky;\n        top: 96px;\n        order: 2;\n      }\n      .vstack {\n        position: relative;\n        height: clamp(480px, 48vw, 620px);\n      }\n      .vis {\n        position: absolute;\n        inset: 0;\n        opacity: 0;\n        transform: translateY(14px);\n        transition:\n          opacity 0.55s ease,\n          transform 0.55s ease;\n        pointer-events: none;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n      }\n      .vis.on {\n        opacity: 1;\n        transform: none;\n        pointer-events: auto;\n      }\n      .vlabel {\n        margin-top: 16px;\n        display: flex;\n        align-items: center;\n        gap: 9px;\n        font-family: Inter, sans-serif;\n        font-size: 13px;\n        color: #8b8b8b;\n      }\n      .vlabel i {\n        width: 7px;\n        height: 7px;\n        border-radius: 50%;\n        background: var(--accent);\n        flex: none;\n      }\n      .scopy {\n        order: 1;\n      }\n      .sblock {\n        min-height: 74vh;\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        opacity: 0.32;\n        transition: opacity 0.45s ease;\n      }\n      .sblock.on {\n        opacity: 1;\n      }\n      .sblock h3 {\n        font-size: clamp(24px, 2.9vw, 40px);\n        font-weight: 400;\n        letter-spacing: -0.02em;\n        line-height: 1