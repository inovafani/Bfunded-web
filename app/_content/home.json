\n      crossorigin=\"anonymous\"\n    ></script>\n    <script\n      src=\"https://cdn.prod.website-files.com/68906c2eb26f26166bc996df/js/webflow.schunk.afd6e78de6594c54.js\"\n      type=\"text/javascript\"\n      integrity=\"sha384-3+gWjbQNva/1mKBjs2yNWyZqGKKTk412eX+n1kM399WEtLWjc/3TWdaP+WrqccT3\"\n      crossorigin=\"anonymous\"\n    ></script>\n    <script\n      src=\"https://cdn.prod.website-files.com/68906c2eb26f26166bc996df/js/webflow.schunk.dac51c455b7e76af.js\"\n      type=\"text/javascript\"\n      integrity=\"sha384-ZQ6U9fIU+7NO4yp5YptTIwCSqp+zvOO+9sjFM6NR3D4Ma7CCSf/lR7Ilthe4YRiw\"\n      crossorigin=\"anonymous\"\n    ></script>\n    <script\n      src=\"https://cdn.prod.website-files.com/68906c2eb26f26166bc996df/js/webflow.schunk.9dfb96661114d3db.js\"\n      type=\"text/javascript\"\n      integrity=\"sha384-WomGmw6dEzLneGT/kPgtEBxcnZdNwGyYjo8D14umPoCXFAogmplTeXR1XciQq32y\"\n      crossorigin=\"anonymous\"\n    ></script>\n    <script\n      src=\"https://cdn.prod.website-files.com/68906c2eb26f26166bc996df/js/webflow.b37b3f1f.9f0ac2d713d301a2.js\"\n      type=\"text/javascript\"\n      integrity=\"sha384-UMHJxpaJiJFJryNBjBHtCsXAh63prRdM0IWHDCaOtYXVuaCGnB/ENXhD6JznD3Ed\"\n      crossorigin=\"anonymous\"\n    ></script>\n    <script>\n      document.querySelectorAll(\".countdown-block\").forEach(function (wrapper) {\n        var dateEl = wrapper.querySelector(\".launch-date\");\n        var countdownEl = wrapper.querySelector(\".countdown\");\n\n        if (!dateEl || !countdownEl) {\n          console.error(\"Struktur tidak lengkap di countdown-block\", wrapper);\n          return;\n        }\n\n        var dateText = dateEl.innerText.trim();\n        // hapus st, nd, rd, th (misal: 14th \u2192 14)\n        dateText = dateText.replace(/(\\d+)(st|nd|rd|th)/i, \"$1\");\n\n        var targetDate = new Date(dateText + \" 00:00:00\").getTime();\n        if (isNaN(targetDate)) {\n          console.error(\"Tanggal tidak valid:\", dateText);\n          return;\n        }\n\n        var daysEl = countdownEl.querySelector(\".days\");\n        var hoursEl = countdownEl.querySelector(\".hours\");\n        var minutesEl = countdownEl.querySelector(\".minutes\");\n        var secondsEl = countdownEl.querySelector(\".seconds\");\n\n        function updateCountdown() {\n          var now = new Date().getTime();\n          var distance = targetDate - now;\n\n          if (distance <= 0) {\n            countdownEl.innerHTML = \"Launched \ud83d\ude80\";\n            return;\n          }\n\n          var days = Math.floor(distance / (1000 * 60 * 60 * 24));\n          var hours = Math.floor(\n            (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60),\n          );\n          var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));\n          var seconds = Math.floor((distance % (1000 * 60)) / 1000);\n\n          if (daysEl) daysEl.textContent = days;\n          if (hoursEl) hoursEl.textContent = hours;\n          if (minutesEl) minutesEl.textContent = minutes;\n          if (secondsEl) secondsEl.textContent = seconds;\n        }\n\n        updateCountdown();\n        setInterval(updateCountdown, 1000);\n      });\n    </script>\n\n    <!-- \n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() {\n  const goal = 100000; // target tetap\n\n  // ambil nilai current dari teks (misal \"$77,811\")\n  let currentText = document.querySelector('.progress-current').textContent;\n  let current = parseInt(currentText.replace(/\\$|,/g, ''));\n\n  // hitung sisa & persen\n  let left = goal - current;\n  let percent = (current / goal) * 100;\n  if (percent > 100) percent = 100;\n\n  // update bar\n  document.querySelector('.progress-bar-fill').style.width = percent + \"%\";\n\n  // update teks sisa\n  document.querySelector('.progress-left').textContent = \"$\" + left.toLocaleString() + \" LEFT\";\n});\n</script>\n\nprogress-bar dynamic -->\n\n    <!-- show more -->\n    <script>\n      document.addEventListener(\"DOMContentLoaded\", function () {\n        const container = document.querySelector(\".highlights-container\");\n        const button = document.querySelector(\".toogle-button\");\n\n        if (!container || !button) return;\n\n        let isExpanded = false;\n\n        button.addEventListener(\"click\", function () {\n          if (!isExpanded) {\n            container.style.maxHeight = container.scrollHeight + \"px\";\n            button.innerText = \"Show Less\";\n          } else {\n            container.style.maxHeight = \"310px\";\n            button.innerText = \"Show More\";\n          }\n\n          isExpanded = !isExpanded;\n        });\n      });\n    </script>\n\n    <style>\n      .popup-overlay {\n        background-color: rgba(0, 0, 0, 0.3); /* black with 30% opacity */\n      }\n\n      .strikethrough-text {\n        text-decoration: line-through;\n        color: red;\n      }\n    </style>\n\n    <style>\n      .highlights-container {\n        max-height: 310px;\n        transition: max-height 0.5s ease;\n      }\n    </style>\n\n    <!-- Nav-links JS -->\n    <script>\n      document.addEventListener(\"DOMContentLoaded\", function () {\n        const toggle = document.querySelector('[data-nav-toggle=\"true\"]');\n        const panel = document.querySelector('[data-nav-panel=\"true\"]');\n        if (!toggle || !panel) return;\n\n        toggle.addEventListener(\"click\", function (e) {\n          e.preventDefault();\n          panel.classList.toggle(\"is-open\");\n        });\n\n        // optional: close when clicking outside\n        document.addEventListener(\"click\", function (e) {\n          if (!panel.classList.contains(\"is-open\")) return;\n          const inside = panel.contains(e.target) || toggle.contains(e.target);\n          if (!inside) panel.classList.remove(\"is-open\");\n        });\n      });\n    </script>\n\n    <!-- slider screenshot phone -->\n    <script>\n      document.addEventListener(\"DOMContentLoaded\", function () {\n        const slider = document.querySelector(\".dm-showcase-slider\");\n        if (!slider) return;\n\n        const slidesWrap = slider.querySelector(\".dm-slides\");\n        const slides = Array.from(slider.querySelectorAll(\".dm-slide\"));\n        const dots = Array.from(slider.querySelectorAll(\".dm-slider-dot\"));\n\n        if (!slidesWrap || !slides.length || !dots.length) return;\n\n        function measureSlideHeight(slide) {\n          if (!slide) return 0;\n\n          const wasActive = slide.classList.contains(\"is-active\");\n          const prev = {\n            position: slide.style.position,\n            inset: slide.style.inset,\n            visibility: slide.style.visibility,\n            opacity: slide.style.opacity,\n            pointerEvents: slide.style.pointerEvents,\n            transform: slide.style.transform,\n            display: slide.style.display,\n          };\n\n          slide.style.position = \"relative\";\n          slide.style.inset = \"auto\";\n          slide.style.visibility = \"hidden\";\n          slide.style.opacity = \"0\";\n          slide.style.pointerEvents = \"none\";\n          slide.style.transform = \"none\";\n          slide.style.display = \"block\";\n\n          if (!wasActive) slide.classList.add(\"is-active\");\n\n          const height = slide.offsetHeight;\n\n          if (!wasActive) slide.classList.remove(\"is-active\");\n\n          slide.style.position = prev.position;\n          slide.style.inset = prev.inset;\n          slide.style.visibility = prev.visibility;\n          slide.style.opacity = prev.opacity;\n          slide.style.pointerEvents = prev.pointerEvents;\n          slide.style.transform = prev.transform;\n          slide.style.display = prev.display;\n\n          return height;\n        }\n\n        function setSlidesHeight(index) {\n          const activeSlide = slides[index];\n          if (!activeSlide) return;\n\n          const height = measureSlideHeight(activeSlide);\n          if (height > 0) {\n            slidesWrap.style.height = height + \"px\";\n          }\n        }\n\n        function goToSlide(index) {\n          slides.forEach((slide, i) => {\n            slide.classList.toggle(\"is-active\", i === index);\n          });\n\n          dots.forEach((dot, i) => {\n            dot.classList.toggle(\"is-active\", i === index);\n          });\n\n          setSlidesHeight(index);\n        }\n\n        dots.forEach((dot, index) => {\n          dot.addEventListener(\"click\", function (e) {\n            e.preventDefault();\n            goToSlide(index);\n          });\n        });\n\n        const defaultActiveIndex = slides.findIndex((slide) =>\n          slide.classList.contains(\"is-active\"),\n        );\n\n        const startIndex = defaultActiveIndex > -1 ? defaultActiveIndex : 0;\n\n        goToSlide(startIndex);\n        slider.classList.add(\"is-ready\");\n\n        requestAnimationFrame(() => {\n          setSlidesHeight(startIndex);\n        });\n\n        window.addEventListener(\"load\", function () {\n          const activeIndex = slides.findIndex((slide) =>\n            slide.classList.contains(\"is-active\"),\n          );\n          if (activeIndex !== -1) {\n            setSlidesHeight(activeIndex);\n          }\n        });\n\n        window.addEventListener(\"resize\", function () {\n          const activeIndex = slides.findIndex((slide) =>\n            slide.classList.contains(\"is-active\"),\n          );\n          if (activeIndex !== -1) {\n            setSlidesHeight(activeIndex);\n          }\n        });\n\n        if (\"ResizeObserver\" in window) {\n          const observer = new ResizeObserver(() => {\n            const activeIndex = slides.findIndex((slide) =>\n              slide.classList.contains(\"is-active\"),\n            );\n            if (activeIndex !== -1) {\n              setSlidesHeight(activeIndex);\n            }\n          });\n\n          slides.forEach((slide) => observer.observe(slide));\n        }\n      });\n    </script>\n\n    <!-- tabs customs -->\n    <script>\n      document.addEventListener(\"DOMContentLoaded\", function () {\n        const wrappers = document.querySelectorAll(\".dm-right-inner\");\n\n        wrappers.forEach((wrapper) => {\n          const track = wrapper.querySelector(\".dm-tabs-track\");\n          const pill = wrapper.querySelector(\".dm-tabs-pill\");\n          const tabButtons = wrapper.querySelectorAll(\".dm-tab-btn\");\n          const panelsWrap = wrapper.querySelector(\".dm-panels\");\n          const panels = wrapper.querySelectorAll(\".dm-panel\");\n\n          const diffContainer =\n            wrapper.closest(\".dm-diff-container\") || document;\n          const bgItems = diffContainer.querySelectorAll(\".dm-bg-item\");\n\n          if (\n            !track ||\n            !pill ||\n            !tabButtons.length ||\n            !panels.length ||\n            !panelsWrap\n          )\n            return;\n\n          function measurePanelHeight(panel) {\n            if (!panel) return 0;\n\n            const prev = {\n              position: panel.style.position,\n              inset: panel.style.inset,\n              visibility: panel.style.visibility,\n              opacity: panel.style.opacity,\n              pointerEvents: panel.style.pointerEvents,\n              transform: panel.style.transform,\n              display: panel.style.display,\n            };\n\n            panel.style.position = \"relative\";\n            panel.style.inset = \"auto\";\n            panel.style.visibility = \"hidden\";\n            panel.style.opacity = \"0\";\n            panel.style.pointerEvents = \"none\";\n            panel.style.transform = \"none\";\n            panel.style.display = \"block\";\n\n            const height = panel.offsetHeight;\n\n            panel.style.position = prev.position;\n            panel.style.inset = prev.inset;\n            panel.style.visibility = prev.visibility;\n            panel.style.opacity = prev.opacity;\n            panel.style.pointerEvents = prev.pointerEvents;\n            panel.style.transform = prev.transform;\n            panel.style.display = prev.display;\n\n            return height;\n          }\n\n          function setPanelsHeight(tabName) {\n            const activePanel = wrapper.querySelector(\n              '.dm-panel[data-dm-panel=\"' + tabName + '\"]',\n            );\n            if (!activePanel) return;\n\n            const height = measurePanelHeight(activePanel);\n            if (height > 0) {\n              panelsWrap.style.height = height + \"px\";\n            }\n          }\n\n          function movePill() {\n            const activeBtn = wrapper.querySelector(\".dm-tab-btn.is-active\");\n            if (!activeBtn) return;\n\n            const trackRect = track.getBoundingClientRect();\n            const btnRect = activeBtn.getBoundingClientRect();\n\n            const left = btnRect.left - trackRect.left;\n            const width = btnRect.width;\n\n            pill.style.transform = \"translateX(\" + left + \"px)\";\n            pill.style.width = width + \"px\";\n          }\n\n          function activateTab(tabName) {\n            tabButtons.forEach((btn) => {\n              const isMatch = btn.getAttribute(\"data-dm-tab\") === tabName;\n              btn.classList.toggle(\"is-active\", isMatch);\n            });\n\n            panels.forEach((panel) => {\n              const isMatch = panel.getAttribute(\"data-dm-panel\") === tabName;\n              panel.classList.toggle(\"is-active\", isMatch);\n            });\n\n            bgItems.forEach((bg) => {\n              const isMatch = bg.getAttribute(\"data-dm-bg\") === tabName;\n              bg.classList.toggle(\"is-active\", isMatch);\n            });\n\n            movePill();\n            setPanelsHeight(tabName);\n          }\n\n          tabButtons.forEach((btn) => {\n            btn.addEventListener(\"click\", function () {\n              const tabName = btn.getAttribute(\"data-dm-tab\");\n              if (!tabName) return;\n              activateTab(tabName);\n            });\n          });\n\n          const defaultActive =\n            wrapper.querySelector(\".dm-tab-btn.is-active\") ||\n            wrapper.querySelector('.dm-tab-btn[data-dm-tab=\"plan\"]');\n\n          if (defaultActive) {\n            activateTab(defaultActive.getAttribute(\"data-dm-tab\"));\n          }\n\n          window.addEventListener(\"resize\", function () {\n            const activeBtn = wrapper.querySelector(\".dm-tab-btn.is-active\");\n            if (!activeBtn) return;\n\n            const tabName = activeBtn.getAttribute(\"data-dm-tab\");\n            movePill();\n            setPanelsHeight(tabName);\n          });\n        });\n      });\n    </script>\n\n    <!-- testi slides custom -->\n    <script>\n      document.addEventListener(\"DOMContentLoaded\", function () {\n        const slider = document.querySelector(\".dm-testi-slider\");\n        if (!slider) return;\n\n        const track = slider.querySelector(\".dm-testi-track\");\n        const items = Array.from(slider.querySelectorAll(\".dm-testi-item\"));\n        const dots = Array.from(slider.querySelectorAll(\".dm-testi-dot\"));\n        const prevBtn = document.getElementById(\"dm-testi-prev\");\n        const nextBtn = document.getElementById(\"dm-testi-next\");\n\n        if (!track || !items.length) return;\n\n        let current = items.findIndex((item) =>\n          item.classList.contains(\"is-active\"),\n        );\n        if (current < 0) current = 0;\n\n        function setTrackHeight(index) {\n          const activeItem = items[index];\n          if (!activeItem) return;\n\n          const prevVisibility = activeItem.style.visibility;\n          const prevPosition = activeItem.style.position;\n          const prevOpacity = activeItem.style.opacity;\n\n          activeItem.style.visibility = \"visible\";\n          activeItem.style.position = \"relative\";\n          activeItem.style.opacity = \"1\";\n\n          const h = activeItem.offsetHeight;\n          if (h > 0) track.style.height = h + \"px\";\n\n          activeItem.style.visibility = prevVisibility;\n          activeItem.style.position = prevPosition;\n          activeItem.style.opacity = prevOpacity;\n        }\n\n        function render(index) {\n          items.forEach((item, i) => {\n            item.classList.toggle(\"is-active\", i === index);\n          });\n\n          dots.forEach((dot, i) => {\n            dot.classList.toggle(\"is-active\", i === index);\n          });\n\n          current = index;\n          requestAnimationFrame(() => setTrackHeight(current));\n        }\n\n        function goTo(index) {\n          if (index < 0) index = items.length - 1;\n          if (index >= items.length) index = 0;\n          if (index === current) return;\n          render(index);\n        }\n\n        function goPrev() {\n          goTo(current - 1);\n        }\n\n        function goNext() {\n          goTo(current + 1);\n        }\n\n        if (prevBtn) {\n          prevBtn.addEventListener(\"click\", function (e) {\n            e.preventDefault();\n            e.stopPropagation();\n            goPrev();\n          });\n        }\n\n        if (nextBtn) {\n          nextBtn.addEventListener(\"click\", function (e) {\n            e.preventDefault();\n            e.stopPropagation();\n            goNext();\n          });\n        }\n\n        dots.forEach((dot, index) => {\n          dot.addEventListener(\"click\", function (e) {\n            e.preventDefault();\n            e.stopPropagation();\n            goTo(index);\n          });\n        });\n\n        window.addEventListener(\"resize\", function () {\n          setTrackHeight(current);\n        });\n\n        render(current);\n      });\n    </script>\n    <script>\n      (function () {\n        if (window.matchMedia(\"(max-width: 991px)\").matches) return;\n        document.addEventListener(\"DOMContentLoaded\", function () {\n          var slider = document.querySelector(\".dm-showcase-slider\");\n          if (!slider) return;\n          var dots = slider.querySelectorAll(\".dm-slider-dot\");\n          var n = dots.length;\n          if (n < 2) return;\n          var wrap = document.createElement(\"div\");\n          wrap.className = \"bf-scrollwrap\";\n          slider.parentNode.insertBefore(wrap, slider);\n          wrap.appendChild(slider);\n          var current = -1;\n          function onScroll() {\n            var r = wrap.getBoundingClientRect();\n            var total = r.height - window.innerHeight;\n            var p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 0;\n            var idx = Math.min(n - 1, Math.floor(p * n));\n            if (idx !== current) {\n              current = idx;\n              dots[idx].click();\n            }\n          }\n          window.addEventListener(\"scroll\", onScroll, { passive: true });\n          window.addEventListener(\"resize\", onScroll);\n          onScroll();\n        });\n      })();\n    </script>\n  \n<script>\n(function () {\n  var form = document.getElementById('wf-form-New-Waitlist-Form');\n  if (!form) return;\n  var wrap = form.closest('.w-form') || form.parentElement;\n  var done = wrap && wrap.querySelector('.w-form-done');\n  var fail = wrap && wrap.querySelector('.w-form-fail');\n\n  // Optional Google Apps Script endpoint (Sheet log + email notification).\n  // Rendered by app/page.tsx from NEXT_PUBLIC_SHEETS_ENDPOINT; absent = skipped.\n  var sheetsMeta = document.querySelector('meta[name=\"bf-sheets-endpoint\"]');\n  var sheetsUrl = sheetsMeta && sheetsMeta.getAttribute('content');\n\n  form.addEventListener('submit', function (e) {\n    // Webflow's own handler would post to Webflow; take the event first.\n    e.preventDefault();\n    e.stopImmediatePropagation();\n\n    var btn = form.querySelector('[type=submit]');\n    var label = btn && btn.value;\n    if (btn) { btn.value = btn.getAttribute('data-wait') || 'Please wait...'; btn.disabled = true; }\n\n    var data = new FormData(form);\n    data.append('source', location.pathname);\n    var body = new URLSearchParams(data).toString();\n\n    // Mirror to the Sheet first, fire-and-forget: no-cors means we cannot read the\n    // reply, and a Sheet outage must never block the actual submission.\n    if (sheetsUrl) {\n      try {\n        fetch(sheetsUrl, {\n          method: 'POST',\n          mode: 'no-cors',\n          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n          body: body\n        }).catch(function () {});\n      } catch (err) {}\n    }\n\n    // Netlify Forms is the system of record.\n    fetch('/__forms.html', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },\n      body: body\n    }).then(function (r) {\n      if (!r.ok) throw new Error(r.status);\n      form.style.display = 'none';\n      if (done) done.style.display = 'block';\n    }).catch(function () {\n      if (fail) fail.style.display = 'block';\n    }).finally(function () {\n      if (btn) { btn.value = label; btn.disabled = false; }\n    });\n  }, true);\n})();\n</script>\n"