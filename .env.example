# Canonical origin for metadataBase, canonicals, OG image URLs and the sitemap.
# Leave unset and lib/site.ts falls back to Netlify's build-time URL variable,
# then to https://www.bfunded.io. Set this once the real domain is attached.
# NEXT_PUBLIC_SITE_URL=https://www.bfunded.io

# Google Apps Script web-app URL for the waitlist form. Every submission is
# mirrored there, which appends a row to a Google Sheet and emails the team.
# See docs/google-apps-script.gs for the script and setup steps.
# Unset = the form still works, it just skips the mirror.
# NEXT_PUBLIC_SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXX/exec

# ---------------------------------------------------------------------------
# Blog CMS (Supabase)
# ---------------------------------------------------------------------------
# From the Supabase dashboard: Project Settings -> API.
# The first two are public by design (they are shipped to the browser and are
# limited by row level security). The third is a server-only secret that
# bypasses RLS -- never prefix it with NEXT_PUBLIC_, never commit it.
#
# Without these the marketing pages still build and serve; /blog renders empty
# and /admin shows a setup notice. See docs/cms-setup.md.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
